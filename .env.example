# Copy this file to .env.local and fill in your own values.
# The fixed archive intentionally excludes .env.local to avoid leaking secrets.

# ── Required for auth cookies/JWT signing ──
JWT_SECRET=your_random_secret_at_least_32_chars

# ── Optional: leave TURSO_DATABASE_URL empty to use local SQLite at data/app.db ──
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── DeepSeek AI ──
DEEPSEEK_TRANSLATE_KEY=
DEEPSEEK_LOOKUP_KEY=
DEEPSEEK_ANALYZE_KEY=
DEEPSEEK_CHAT_KEY=
DEEPSEEK_VOICE_KEY=
DEEPSEEK_HANDWRITING_KEY=
DEEPSEEK_PLAN_KEY=
DEEPSEEK_NEWS_KEY=

# ── TTS (Qwen3-TTS via Alibaba Cloud DashScope) ──
DASHSCOPE_API_KEY=
