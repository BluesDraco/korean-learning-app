# Copy this file to .env.local and fill in your own values.
# The fixed archive intentionally excludes .env.local to avoid leaking secrets.

# ── Required for auth cookies/JWT signing ──
JWT_SECRET=your_random_secret_at_least_32_chars

# ── Optional: leave TURSO_DATABASE_URL empty to use local SQLite at data/app.db ──
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── DeepSeek AI ──
DEEPSEEK_TRANSLATE_KEY=
DEEPSEEK_SHADOWING_KEY=
DEEPSEEK_LOOKUP_KEY=
DEEPSEEK_ANALYZE_KEY=
DEEPSEEK_CHAT_KEY=
DEEPSEEK_VOICE_KEY=
DEEPSEEK_WRITING_KEY=
DEEPSEEK_JUDGE_KEY=
DEEPSEEK_SPEAKING_KEY=
DEEPSEEK_NEWS_KEY=

# ── TTS (Qwen3-TTS via Alibaba Cloud DashScope) ──
DASHSCOPE_API_KEY=

# ── 部署版本（域名分流，非运行时判断用户国别）──
# 国内站(¥/聚合支付)留空或 domestic；海外站(香港服务器,$/Stripe)填 overseas
NEXT_PUBLIC_EDITION=domestic

# 本机 edge-tts 服务地址；海外站若不自建，可跨境指向上海：http://<上海IP>:8800/tts
TTS_UPSTREAM=http://localhost:8800/tts

# ── 支付渠道（默认 mock 模拟收银台；海外站接 Stripe 时设 stripe 并补 key）──
PAYMENT_PROVIDER=mock
# 海外站 Stripe（一次性买断）。测试用 sk_test_，上线换 sk_live_
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx   # 在 Stripe 后台 Webhooks 建端点后获得
# 国内站 虎皮椒（聚合支付，接支付宝）。设 PAYMENT_PROVIDER=xunhupay 并补下面三项
# XUNHUPAY_APPID=xxx                 # 虎皮椒后台「我的应用」
# XUNHUPAY_SECRET=xxx                # 虎皮椒后台「我的应用」
# XUNHUPAY_GATEWAY=https://api.xunhupay.com   # 后台若给了专属网关按后台为准
# 国内站 XorPay（聚合支付，微信+支付宝，官方直结算非二清）。设 PAYMENT_PROVIDER=xorpay 并补下面
# XORPAY_AID=xxx                     # XorPay 后台的 aid
# XORPAY_APP_SECRET=xxx              # XorPay 后台的 app_secret（绝不能暴露到前端）
# XORPAY_GATEWAY=https://xorpay.com
# XORPAY_PAY_TYPE=alipay             # 收银台默认支付方式：alipay（唤起支付宝）；微信内可设 cashier 自适应

# 站点绝对地址，用于拼支付回跳/异步通知地址（Stripe success、虎皮椒 notify_url/return_url）
# 国内站填 https://torikorean.com，海外站填 https://你的.cn 域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 站间统一后台（仅上海站需要；跨站聚合看国内/海外/综合）──
# 两站填同一串随机密钥（供上海调香港内部接口时校验身份）
# INTERNAL_API_SECRET=<openssl rand -hex 32 生成>
# 只上海站填：香港站公网地址（上海后台看海外/综合时请求它）
# PEER_SITE_URL=https://你的海外域名

# ── Google 登录（仅海外站）──
# Google Cloud Console 建 OAuth 客户端拿到；回调地址填 https://你的.cn/api/auth/google/callback
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# ── Resend 邮件发送（仅海外站，邮箱注册验证码）──
# 去 resend.com 注册（不要信用卡），拿 API key，验证域名后填发件地址
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=noreply@你的.cn   # 测试阶段可用 onboarding@resend.dev

# ── Aliyun NLS 语音识别（ASR 发音评测）──
# ALIYUN_NLS_APPKEY=xxx
# ALIYUN_ACCESS_KEY_ID=xxx
# ALIYUN_ACCESS_KEY_SECRET=xxx

# ── MiniMax TTS（兔莉音色、电台嘉宾音色）──
# MINIMAX_API_KEY=sk-cp-xxx
# MINIMAX_GROUP_ID=xxx

# ── 腾讯云 SES 邮件发送（国内站邮箱验证码）──
# TENCENT_SES_SECRET_ID=xxx
# TENCENT_SES_SECRET_KEY=xxx
# TENCENT_SES_FROM=noreply@你的.com

# ── 搜索引擎站长验证（仅国内站）──
# NEXT_PUBLIC_VERIFY_BAIDU=xxx
# NEXT_PUBLIC_VERIFY_BING=xxx
# NEXT_PUBLIC_VERIFY_SOGOU=xxx（待补）
# NEXT_PUBLIC_VERIFY_SHENMA=（已放弃）

# ── 百度自动推送（仅国内站）──
# BAIDU_PUSH_TOKEN=xxx
