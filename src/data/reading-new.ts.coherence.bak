      zh: "这种执着的反转结构，与韩国人在日常中承受的压力恐怕不无关系。",
      pronunciation: "i jibyohan banjeon gujoneun hangugini ilsangeseo gamdanghaneun seuteureseuwa mugwanhaji anheul geosida.",
      words: [{"word":"집요하다","meaning":"执着的/顽强的"},{"word":"감당하다","meaning":"承受"},{"word":"무관하지 않다","meaning":"不无关系"}],
      grammarIds: [],
