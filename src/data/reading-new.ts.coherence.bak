    '掌握 -는데、-기 때문에、-(으)면서 等 B1 常用句型',
    '学会用间接引语 -다고 하다 转述他人观点',
    '积累音乐与影视领域的高频词汇',
  ],
  coreWords: [
    { word: '주제가', meaning: '主题曲', pronunciation: '', examples: [{ ko: "인기 드라마의 주제가는 방송이 끝나기도 전에 음원 차트 상위권에 오르기도 합니다.", zh: "人气剧的主题曲，甚至在剧还没播完之前就登上了音源榜的前列。" }, { ko: "이 드라마의 주제가를 아이돌 그룹이 불러서 화제가 됐어요.", zh: "这部剧的主题曲由偶像组合演唱，引起了热议。" }] },
    { word: '음원', meaning: '音源/数字单曲', pronunciation: '', examples: [{ ko: "인기 드라마의 주제가는 방송이 끝나기도 전에 음원 차트 상위권에 오르기도 합니다.", zh: "人气剧的主题曲，甚至在剧还没播完之前就登上了音源榜的前列。" }, { ko: "새 음원이 오늘 밤 자정에 공개됩니다.", zh: "新的音源今晚零点公开。" }] },
    { word: '차트', meaning: '排行榜', pronunciation: '', examples: [{ ko: "인기 드라마의 주제가는 방송이 끝나기도 전에 음원 차트 상위권에 오르기도 합니다.", zh: "人气剧的主题曲，甚至在剧还没播完之前就登上了音源榜的前列。" }, { ko: "그 노래는 음원 차트 1위를 차지했어요.", zh: "那首歌占据了音源榜第一名。" }] },
    { word: '가사', meaning: '歌词', pronunciation: '', examples: [{ ko: "OST의 가사는 주인공의 마음을 대신 말해 주기 때문에 팬들에게 특별한 의미가 있습니다.", zh: "OST 的歌词替主人公道出了心声，所以对粉丝来说有着特别的意义。" }, { ko: "이 노래는 가사가 슬퍼서 들을 때마다 눈물이 나요.", zh: "这首歌的歌词很悲伤，每次听都会流泪。" }] },
    { word: '감정', meaning: '情感', pronunciation: '', examples: [{ ko: "슬픈 장면에서 발라드가 흐르면 시청자들은 더 쉽게 감정에 몰입하게 됩니다.", zh: "当悲伤的场景响起抒情歌时，观众会更容易沉浸在情感之中。" }, { ko: "배우가 슬픈 감정을 아주 잘 표현했어요.", zh: "演员把悲伤的情感表现得非常好。" }] },
    { word: '장면', meaning: '场景/画面', pronunciation: '', examples: [{ ko: "팬들은 좋아하는 장면을 다시 보면서 그 OST를 함께 듣는 것을 즐깁니다.", zh: "粉丝们喜欢一边重温喜欢的场景，一边一起听那首 OST。" }, { ko: "이 장면이 이 드라마에서 가장 인상적이었어요.", zh: "这个场景是这部剧里最令人印象深刻的。" }] },
    { word: '분위기', meaning: '氛围', pronunciation: '', examples: [{ ko: "OST는 드라마를 위해 만든 음악이기 때문에 장면의 분위기와 아주 잘 어울립니다.", zh: "OST 是为电视剧量身打造的音乐，所以和场景的氛围非常契合。" }, { ko: "이 카페는 조용하고 분위기가 좋아요.", zh: "这家咖啡馆安静，氛围很好。" }] },
    { word: '역주행', meaning: '逆行/回锅走红', pronunciation: '', examples: [{ ko: "어떤 곡은 드라마가 끝난 지 몇 년이 지나서 다시 인기를 끄는데, 이것을 역주행이라고 부릅니다.", zh: "有些歌曲在剧结束好几年后重新走红，这种现象被称为「逆行」。" }, { ko: "그 옛날 노래가 최근에 역주행을 하고 있어요.", zh: "那首老歌最近正在逆行走红。" }] },
    { word: '발라드', meaning: '抒情歌/慢歌', pronunciation: '', examples: [{ ko: "슬픈 장면에서 발라드가 흐르면 시청자들은 더 쉽게 감정에 몰입하게 됩니다.", zh: "当悲伤的场景响起抒情歌时，观众会更容易沉浸在情感之中。" }, { ko: "저는 신나는 노래보다 잔잔한 발라드를 더 좋아해요.", zh: "比起欢快的歌，我更喜欢舒缓的抒情歌。" }] },
    { word: '신인', meaning: '新人', pronunciation: '', examples: [{ ko: "흥미로운 점은 OST 덕분에 이름 없던 신인 가수가 갑자기 유명해지는 경우가 많다는 것입니다.", zh: "有趣的是，很多默默无闻的新人歌手因为 OST 而突然走红。" }, { ko: "이 영화로 그 신인 배우가 처음 얼굴을 알렸어요.", zh: "那位新人演员凭这部电影首次崭露头角。" }] },
    { word: '녹음', meaning: '录音', pronunciation: '', examples: [{ ko: "가수들은 캐릭터의 감정을 이해한 뒤에 녹음을 시작한다고 합니다.", zh: "据说歌手们会在理解了角色的情感之后才开始录音。" }, { ko: "가수는 스튜디오에서 밤새 녹음을 했어요.", zh: "歌手在录音室通宵录音。" }] },
    { word: '몰입하다', meaning: '沉浸/投入', pronunciation: '', examples: [{ ko: "슬픈 장면에서 발라드가 흐르면 시청자들은 더 쉽게 감정에 몰입하게 됩니다.", zh: "当悲伤的场景响起抒情歌时，观众会更容易沉浸在情感之中。" }, { ko: "이야기가 너무 재미있어서 완전히 몰입했어요.", zh: "故事太有趣了，我完全沉浸其中。" }] },
    { word: '유명해지다', meaning: '变有名', pronunciation: '', examples: [{ ko: "흥미로운 점은 OST 덕분에 이름 없던 신인 가수가 갑자기 유명해지는 경우가 많다는 것입니다.", zh: "有趣的是，很多默默无闻的新人歌手因为 OST 而突然走红。" }, { ko: "그 식당은 방송에 나온 뒤로 갑자기 유명해졌어요.", zh: "那家餐厅上电视后突然出名了。" }] },
    { word: '인기를 끌다', meaning: '受欢迎/走红', pronunciation: '', examples: [{ ko: "어떤 곡은 드라마가 끝난 지 몇 년이 지나서 다시 인기를 끄는데, 이것을 역주행이라고 부릅니다.", zh: "有些歌曲在剧结束好几年后重新走红，这种现象被称为「逆行」。" }, { ko: "요즘 이 드라마가 젊은 사람들 사이에서 인기를 끌고 있어요.", zh: "最近这部剧在年轻人中很受欢迎。" }] },
  ],
  grammarIds: ['g5', 'g6', 'g10', 'g21', 'g28'],
