        ko: "1987년 6월, 전국에서 동시다발적으로 시위가 터졌다.",
        zh: "1987年6月，在全国爆发了同时多发的示威。",
        pronunciation: "1987nyeon 6wol, jeongugeseo dongsidabaljeogeuro siwiga teojyeotda.",
        words: [{ word: "동시다발적", meaning: "同时多发" }, { word: "터지다", meaning: "爆发" }],
        grammarIds: [],
        difficulty: "easy",
