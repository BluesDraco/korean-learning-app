    coreWords: [
      { word: '변천', meaning: '变迁', pronunciation: '', examples: [{ ko: "서울의 도시 변천사는 한국 현대사의 압축판이라 할 수 있다.", zh: "首尔的城市变迁史，可以说是韩国现代史的浓缩版。" }, { ko: "언어는 시대의 흐름에 따라 끊임없이 변천을 거듭한다.", zh: "语言随着时代的潮流，不断反复经历着变迁。" }] },
      { word: '재개발', meaning: '再开发/重建', pronunciation: '', examples: [{ ko: "서울시는 재개발을 계기로 발생하는 젠트리피케이션을 완화하기 위한 다양한 정책을 시행하고 있습니다.", zh: "首尔市正在实施各种政策，以缓解以再开发为契机产生的绅士化问题。" }, { ko: "낡은 주거 지역의 재개발을 둘러싸고 주민들의 의견이 첨예하게 갈렸다.", zh: "围绕老旧居住区的再开发，居民们的意见尖锐分歧。" }] },
      { word: '도심', meaning: '城市中心', pronunciation: '', examples: [{ ko: "이 시기 판자촌과 달동네로 대표되는 불량 주거지가 도심 곳곳에 형성되었습니다.", zh: "这一时期，以板房村和山顶村为代表的劣质居住区在城市中心各处形成。" }, { ko: "출퇴근 시간이면 도심의 도로는 어김없이 극심한 정체를 빚는다.", zh: "一到上下班时间，市中心的道路必然陷入严重的拥堵。" }] },
      { word: '인프라', meaning: '基础设施', pronunciation: '', examples: [{ ko: "대중교통 인프라의 확충을 계기로 서울은 세계 최고 수준의 대중교통 도시로 자리매김했습니다.", zh: "以公共交通基础设施扩充为契机，首尔确立了世界最高水平公共交通城市的地位。" }, { ko: "안정적인 통신 인프라 없이는 디지털 경제의 성장을 기대하기 어렵다.", zh: "没有稳定的通信基础设施，就难以期待数字经济的增长。" }] },
      { word: '젠트리피케이션', meaning: '绅士化/高档化', pronunciation: '', examples: [{ ko: "이 과정에서 원주민 이주 문제, 즉 젠트리피케이션이 새로운 사회적 과제로 떠올랐습니다.", zh: "在这一过程中，原住民迁移问题即绅士化成为新的社会课题浮现出来。" }, { ko: "임대료 급등으로 오래된 상인들이 밀려나는 젠트리피케이션이 심각해지고 있다.", zh: "因租金暴涨导致老商户被挤出的绅士化现象日益严重。" }] },
      { word: '문화 공간', meaning: '文化空间', pronunciation: '', examples: [{ ko: "성수동, 을지로 등 낙후 산업 지역이 힙한 문화 공간으로 탈바꿈한 것도 주목할 만한 변화입니다.", zh: "圣水洞、乙支路等落后工业区转变为时髦文化空间，也是值得关注的变化。" }, { ko: "버려진 방직 공장이 시민을 위한 복합 문화 공간으로 새롭게 태어났다.", zh: "被废弃的纺织工厂，重新蜕变为面向市民的综合文化空间。" }] },
      { word: '재생', meaning: '再生/复兴', pronunciation: '', examples: [{ ko: "2000년대 들어 청계천 복원 사업을 계기로 서울의 도시 재생 패러다임이 바뀌기 시작했습니다.", zh: "进入21世纪，以清溪川复原工程为契机，首尔的城市再生范式开始改变。" }, { ko: "철거 대신 기존 건물을 되살리는 도시 재생 방식이 점차 확산되고 있다.", zh: "以复活既有建筑取代拆除的城市再生方式，正在逐渐扩散开来。" }] },
      { word: '밀집', meaning: '密集', pronunciation: '', examples: [{ ko: "인구가 도심에 지나치게 밀집하면서 각종 도시 문제가 심화되었다.", zh: "随着人口过度密集于市中心，各种城市问题日益加剧。" }, { ko: "이 일대는 소규모 공방이 밀집한 전통 제조업 지구였다.", zh: "这一带曾是小型作坊密集的传统制造业地区。" }] },
      { word: '확장', meaning: '扩张/扩展', pronunciation: '', examples: [{ ko: "도로망의 확장은 도시의 외연을 급속도로 넓혀 놓았다.", zh: "道路网的扩张，使城市的外延迅速扩大。" }, { ko: "무분별한 도시 확장은 녹지 감소라는 부작용을 낳는다.", zh: "盲目的城市扩张，会带来绿地减少这一副作用。" }] },
      { word: '철거', meaning: '拆除', pronunciation: '', examples: [{ ko: "노후 건물의 철거를 앞두고 세입자 보상 문제가 논란이 되었다.", zh: "在老旧建筑拆除前夕，租户补偿问题引发了争议。" }, { ko: "무조건적인 철거보다는 보존과 활용을 검토해야 한다는 목소리가 높다.", zh: "认为应先研究保存与利用，而非无条件拆除的呼声很高。" }] },
      { word: '보존', meaning: '保存/保护', pronunciation: '', examples: [{ ko: "역사 문화 자원의 보존과 현대적 개발을 어떻게 조화시킬지도 지속적인 과제로 남아 있습니다.", zh: "如何协调历史文化资源的保护与现代开发，也作为持续性课题留存下来。" }, { ko: "전통 한옥 마을은 원형 그대로의 보존을 위해 엄격한 규제를 받는다.", zh: "传统韩屋村落为了保存原貌，受到严格的规制。" }] },
      { word: '탈바꿈', meaning: '转变/蜕变', pronunciation: '', examples: [{ ko: "올림픽을 계기로 강남 지역은 현대적인 주거와 상업 지구로 탈바꿈했습니다.", zh: "以奥运会为契机，江南地区转变为现代化的住宅和商业区。" }, { ko: "한적하던 어촌이 불과 십 년 만에 국제적인 관광 도시로 탈바꿈했다.", zh: "曾经宁静的渔村，仅仅十年间就蜕变为国际性的旅游城市。" }] },
      { word: '스카이라인', meaning: '天际线', pronunciation: '', examples: [{ ko: "서울의 스카이라인도 초고층 빌딩의 등장으로 극적으로 탈바꿈하였습니다.", zh: "首尔的天际线也因超高层建筑的出现而发生了戏剧性的转变。" }, { ko: "강변을 따라 늘어선 마천루가 도시의 화려한 스카이라인을 이룬다.", zh: "沿江排列的摩天大楼，构成了城市华丽的天际线。" }] },
      { word: '주거', meaning: '居住/住宅', pronunciation: '', examples: [{ ko: "올림픽을 계기로 강남 지역은 현대적인 주거와 상업 지구로 탈바꿈했습니다.", zh: "以奥运会为契机，江南地区转变为现代化的住宅和商业区。" }, { ko: "청년층의 주거 안정은 오늘날 가장 시급한 정책 과제 중 하나다.", zh: "青年阶层的居住稳定，是当今最紧迫的政策课题之一。" }] },
    ],
    grammarIds: ['g47', 'g49', 'g30', 'g82', 'g48'],
    grammarCardIds: ['card-p13-l05', 'card-p13-l01', 'card-p11-l05', 'card-p9-l06'],
    sentences: [
      {
        id: "s1",
        ko: "서울이 반세기 만에 이토록 극적으로 변천했다는 것은 세계 도시사에서도 유례를 찾기 어려운 일이다.",
        zh: "首尔在半个世纪内发生如此戏剧性的变迁，这在世界城市史上也是罕见的。",
        pronunciation: "seouri bansegi mane itorok geukjeogeuro byeoncheonhaetdaneun geoseun segye dosisaeseodo yuryereul chatgi eoryeoun irida.",
        words: [{ word: "변천", meaning: "变迁" }, { word: "유례", meaning: "先例，前例" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s2",
        ko: "1960년대 서울의 달동네는 산비탈에 빽빽이 들어선 판자촌으로, 도심 외곽을 따라 밀집해 있었다.",
        zh: "1960年代首尔的山坡棚户区，密密麻麻地分布在城市中心外围的山坡上。",
        pronunciation: "1960nyeondae seourui daldongneneun sanbitare ppaekppaegi deureoseon panjachoneuro, dosim oegwageul ttara miljipae isseotda.",
        words: [{ word: "달동네", meaning: "山坡棚户区（直译：月亮村）" }, { word: "밀집", meaning: "密集" }, { word: "도심", meaning: "城市中心" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s3",
        ko: "당시의 주거 환경은 열악하다기보다는 생존 자체가 절박한 상황이었다고 보는 것이 더 정확하다.",
        zh: "与其说当时的居住环境恶劣，不如说那是一种生存本身极度迫切的状况，这样描述更为准确。",
        pronunciation: "dangsiui jugeo hwangyeongeun yeorakadagibodaneun saengjon jachega jeolbakan sanghwangieotdago boneun geosi deo jeonghwakada.",
        words: [{ word: "열악하다", meaning: "恶劣，差" }, { word: "절박하다", meaning: "迫切，紧迫" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s4",
        ko: "국가 주도의 산업화 정책에 기인하여 농촌 인구가 서울로 대거 유입되었고, 이것이 달동네 확장의 직접적 원인이었다.",
        zh: "由于国家主导的工业化政策，农村人口大量涌入首尔，这正是棚户区扩张的直接原因。",
        pronunciation: "gukga judoui saneopwa jeongchaege giinhayeo nongchon inguga seoulro daegeo yuipdoeeotgo, igeosi daldongne hwakjangui jikjeopjeok woninieotda.",
        words: [{ word: "기인하다", meaning: "起因于，源于" }, { word: "확장", meaning: "扩张" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s5",
        ko: "강남 개발은 서울의 도시 구조를 근본적으로 재편한 역사적 전환점이었다.",
        zh: "江南开发是从根本上重组首尔城市结构的历史性转折点。",
        pronunciation: "gangnam gaebareun seourui dosi gujoreul geunbonjeogeuro jaepyeonhan yeoksajeok jeonhwanjeomieotda.",
        words: [{ word: "재편", meaning: "重组，改编" }, { word: "전환점", meaning: "转折点" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s6",
        ko: "1970~80년대 강남 개발에 있어서 정부는 도로, 학교, 상하수도 등 인프라 구축을 최우선으로 추진했다.",
        zh: "在1970至80年代的江南开发中，政府将道路、学校、上下水道等基础设施建设放在首要位置推进。",
