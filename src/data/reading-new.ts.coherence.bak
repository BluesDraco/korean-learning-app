      { word: '생태계', meaning: '生态系统', pronunciation: '', examples: [{ ko: "국내 유니콘 기업의 수는 지속적으로 증가하고 있으며, 이는 생태계의 성숙을 보여주는 지표로 볼 수 있습니다.", zh: "国内独角兽企业的数量持续增加，这可以视为生态系统成熟的指标。" }, { ko: "건강한 창업 생태계는 자본, 인재, 기술이 유기적으로 맞물려 돌아갑니다.", zh: "健康的创业生态系统，是资本、人才与技术有机咬合、协同运转的。" }] },
      { word: '스타트업', meaning: '创业公司/初创企业', pronunciation: '', examples: [{ ko: "실패를 용인하는 문화가 아직 부족하다는 점은 한국 스타트업 생태계의 과제로 남아 있습니다.", zh: "容忍失败的文化尚且不足，这一点仍是韩国创业生态系统的课题。" }, { ko: "많은 스타트업이 창업 초기의 자금난을 넘기지 못하고 문을 닫습니다.", zh: "许多初创企业没能熬过创业初期的资金困难便倒闭了。" }] },
      { word: '벤처', meaning: '风险投资/创业', pronunciation: '', examples: [{ ko: "정부는 벤처 생태계 활성화를 토대로 중소기업과 스타트업 육성 정책을 적극적으로 추진하고 있습니다.", zh: "政府以激活风险投资生态系统为基础，积极推进中小企业和初创企业扶持政策。" }, { ko: "벤처 투자는 높은 위험을 감수하는 만큼 큰 수익을 기대할 수 있습니다.", zh: "风险投资承担着高风险，也因此可期待丰厚的回报。" }] },
      { word: '투자', meaning: '投资', pronunciation: '', examples: [{ ko: "이 스타트업은 창업 이 년 만에 대규모 투자를 유치하는 데 성공했습니다.", zh: "这家初创企业在创业仅两年后就成功吸引了大规模投资。" }, { ko: "초기 단계의 투자는 기업의 성장 방향을 결정짓는 중요한 밑거름이 됩니다.", zh: "初期阶段的投资，是决定企业成长方向的重要基石。" }] },
      { word: '혁신', meaning: '创新/革新', pronunciation: '', examples: [{ ko: "이처럼 도전과 혁신을 토대로 성장해 온 한국의 스타트업 문화는 앞으로도 진화를 멈추지 않을 것입니다.", zh: "如此以挑战与创新为基础不断成长的韩国创业文化，今后也不会停止进化。" }, { ko: "기술 혁신 없이는 치열한 글로벌 경쟁에서 살아남기 어렵습니다.", zh: "没有技术创新，就难以在激烈的全球竞争中存活下来。" }] },
      { word: '유니콘', meaning: '独角兽(企业)', pronunciation: '', examples: [{ ko: "국내 유니콘 기업의 수는 지속적으로 증가하고 있으며, 이는 생태계의 성숙을 보여주는 지표로 볼 수 있습니다.", zh: "国内独角兽企业的数量持续增加，这可以视为生态系统成熟的指标。" }, { ko: "기업 가치가 십억 달러를 넘어서면 흔히 유니콘이라 불립니다.", zh: "当企业估值超过十亿美元时，通常被称为独角兽。" }] },
      { word: '인프라', meaning: '基础设施', pronunciation: '', examples: [{ ko: "한국은 높은 인터넷 보급률과 기술 인프라를 토대로 역동적인 스타트업 생태계를 구축했습니다.", zh: "韩国以高互联网普及率和技术基础设施为基础，构建了充满活力的创业生态系统。" }, { ko: "탄탄한 디지털 인프라는 신생 기업이 빠르게 성장할 수 있는 발판이 됩니다.", zh: "坚实的数字基础设施，是新生企业得以快速成长的跳板。" }] },
      { word: '글로벌', meaning: '全球性的', pronunciation: '', examples: [{ ko: "K-콘텐츠의 글로벌 인기를 토대로 엔터테인먼트 테크 분야 스타트업들이 새롭게 주목받고 있습니다.", zh: "以K-内容的全球热度为基础，娱乐科技领域的创业公司正在重新受到关注。" }, { ko: "작은 내수 시장의 한계를 넘어서기 위해 처음부터 글로벌 진출을 목표로 삼는 기업이 많습니다.", zh: "为突破狭小内需市场的局限，许多企业从一开始就把进军全球作为目标。" }] },
      { word: '규제', meaning: '监管/规制', pronunciation: '', examples: [{ ko: "그러나 과도한 규제와 경직된 노동 시장은 스타트업의 성장을 가로막는 요인으로 지적되고 있습니다.", zh: "然而，过度的监管和僵化的劳动市场被指出是阻碍创业公司成长的因素。" }, { ko: "새로운 산업일수록 규제가 현실을 따라가지 못하는 경우가 많습니다.", zh: "越是新兴产业，监管跟不上现实的情况就越多。" }] },
      { word: '육성', meaning: '培育/扶持', pronunciation: '', examples: [{ ko: "정부는 벤처 생태계 활성화를 토대로 중소기업과 스타트업 육성 정책을 적극적으로 추진하고 있습니다.", zh: "政府以激活风险投资生态系统为基础，积极推进中小企业和初创企业扶持政策。" }, { ko: "우수한 인재 육성은 장기적으로 산업 경쟁력을 좌우하는 열쇠입니다.", zh: "优秀人才的培育，是长期左右产业竞争力的关键。" }] },
      { word: '네트워크', meaning: '网络', pronunciation: '', examples: [{ ko: "창업 초기 단계에서 필요한 자금 조달과 멘토링 네트워크가 점차 체계화되고 있습니다.", zh: "创业初期阶段所需的资金筹集和导师网络正在逐渐系统化。" }, { ko: "폭넓은 인적 네트워크는 사업 기회를 넓히는 든든한 자산이 됩니다.", zh: "广泛的人脉网络，是拓宽商业机会的坚实资产。" }] },
      { word: '경쟁력', meaning: '竞争力', pronunciation: '', examples: [{ ko: "카카오, 네이버, 쿠팡 등 글로벌 경쟁력을 갖춘 기업들은 스타트업에서 출발한 성공 사례로 꼽힙니다.", zh: "具有全球竞争力的Kakao、Naver、Coupang等企业，是从创业公司起步的成功案例。" }, { ko: "가격보다 기술력에서 앞서야 진정한 경쟁력을 확보할 수 있습니다.", zh: "唯有在技术实力上领先而非价格上取胜，才能确保真正的竞争力。" }] },
      { word: '플랫폼', meaning: '平台', pronunciation: '', examples: [{ ko: "이용자가 늘어날수록 가치가 커지는 것이 플랫폼 사업의 핵심 원리입니다.", zh: "用户越多价值越大，这正是平台业务的核心原理。" }, { ko: "많은 스타트업이 판매자와 소비자를 잇는 플랫폼을 기반으로 성장했습니다.", zh: "许多初创企业依托连接卖家与消费者的平台成长起来。" }] },
      { word: '확장성', meaning: '可扩展性', pronunciation: '', examples: [{ ko: "투자자들은 사업 모델의 확장성을 가장 중요한 판단 기준으로 삼습니다.", zh: "投资者把商业模式的可扩展性作为最重要的判断标准。" }, { ko: "확장성이 높은 서비스는 사용자가 급증해도 안정적으로 운영될 수 있습니다.", zh: "可扩展性高的服务，即便用户激增也能稳定运营。" }] },
    ],
    grammarIds: ['g48', 'g82', 'g49', 'g47', 'g54'],
    grammarCardIds: ['card-p29-l03', 'card-p29-l02', 'card-p13-l05', 'card-p13-l01'],
    sentences: [
      {
        id: "s1",
        ko: "카카오와 네이버가 글로벌 기업으로 성장했다는 것은 한국 IT 생태계의 저력을 보여 준다.",
        zh: "카카오和네이버成长为全球企业这一事实，展现了韩国IT生态系统的潜力。",
        pronunciation: "kakaowa neibeoga geulrobeol gieobeuro seongjanghaetdaneun geoseun hanguk IT saengtaegyeui jeoryeogeul boyeo junda.",
        words: [{ word: "저력", meaning: "潜力，底蕴" }, { word: "생태계", meaning: "生态系统" }],
        grammarIds: [],
