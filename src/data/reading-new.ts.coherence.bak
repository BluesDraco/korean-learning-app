      { word: '환승', meaning: '换乘', pronunciation: '', examples: [{ ko: "다음 도시로 가려면 큰 역에서 한 번 환승해야 했어요.", zh: "要去下一座城市，需要在大站换乘一次。" }, { ko: "이 역에서 지하철로 환승할 수 있어요.", zh: "在这个站可以换乘地铁。" }] },
      { word: '일정', meaning: '行程/日程', pronunciation: '', examples: [{ ko: "이번 여행 일정을 미리 짜 두었어요.", zh: "这次旅行的行程我提前安排好了。" }, { ko: "일정이 빡빡해서 조금 피곤했어요.", zh: "行程太紧，有点累。" }] },
      { word: '지방', meaning: '地方/外地', pronunciation: '', examples: [{ ko: "첫 번째 목적지는 바다로 유명한 지방의 작은 도시였어요.", zh: "第一个目的地是以大海闻名的一座地方小城。" }, { ko: "저는 서울이 아니라 지방에서 자랐어요.", zh: "我不是在首尔，而是在外地长大的。" }] },
      { word: '느긋하다', meaning: '悠闲/从容', pronunciation: '', examples: [{ ko: "창밖을 보면서 음악을 들으니까 마음이 아주 느긋해졌어요.", zh: "一边看着窗外一边听音乐，心情变得非常悠闲。" }, { ko: "휴가 때는 아무것도 안 하고 느긋하게 쉬고 싶어요.", zh: "休假时想什么都不做，悠闲地休息。" }] },
