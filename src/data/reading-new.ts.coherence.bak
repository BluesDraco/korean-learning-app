        pronunciation: "'beoning'eun kaneseo sangeul batji mothaetjiman, haeoe pyeongrongadeul saieseo \"2018nyeon choegoui yeonghwa\"raneun pyeonggaga ssojajyeotda.",
        words: [{ word: "평론가", meaning: "评论家" }, { word: "쏟아지다", meaning: "纷纷涌现" }],
