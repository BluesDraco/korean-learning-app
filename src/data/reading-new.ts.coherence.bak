  coreWords: [
    { word: '장르', meaning: '类型、体裁', pronunciation: '', examples: [{ ko: "한국 드라마는 지난 수십 년 동안 뚜렷한 장르의 변화를 겪어 왔다.", zh: "韩国电视剧在过去数十年间经历了明显的类型变化。" }, { ko: "그 감독은 다양한 장르의 영화를 시도해 왔다.", zh: "那位导演一直尝试各种类型的电影。" }] },
    { word: '변화', meaning: '变化', pronunciation: '', examples: [{ ko: "결국 플랫폼의 변화가 콘텐츠의 다양성을 이끌어 냈다고 할 수 있다.", zh: "归根结底，可以说是平台的变化带来了内容的多样性。" }, { ko: "기술의 발전은 사회 전반에 큰 변화를 가져왔다.", zh: "技术的发展给整个社会带来了巨大的变化。" }] },
    { word: '가족극', meaning: '家庭剧', pronunciation: '', examples: [{ ko: "초기의 드라마는 대부분 가족극이나 멜로에 집중되어 있었다.", zh: "早期的电视剧大多集中在家庭剧或爱情剧上。" }, { ko: "명절이 되면 온 가족이 함께 볼 수 있는 가족극이 인기를 끈다.", zh: "每逢节日，全家能一起看的家庭剧就很受欢迎。" }] },
    { word: '멜로', meaning: '爱情剧、言情', pronunciation: '', examples: [{ ko: "초기의 드라마는 대부분 가족극이나 멜로에 집중되어 있었다.", zh: "早期的电视剧大多集中在家庭剧或爱情剧上。" }, { ko: "그 배우는 멜로 연기로 특히 사랑받는다.", zh: "那位演员因言情剧的演技尤其受喜爱。" }] },
    { word: '스릴러', meaning: '惊悚片', pronunciation: '', examples: [{ ko: "이에 따라 스릴러, 복수극, 좀비물과 같은 새로운 장르가 폭발적으로 늘어났다.", zh: "因此，惊悚、复仇剧、丧尸片等新类型呈爆发式增长。" }, { ko: "긴장감 넘치는 스릴러는 젊은 시청자에게 인기가 높다.", zh: "充满紧张感的惊悚片在年轻观众中很有人气。" }] },
    { word: '복수', meaning: '复仇', pronunciation: '', examples: [{ ko: "이에 따라 스릴러, 복수극, 좀비물과 같은 새로운 장르가 폭발적으로 늘어났다.", zh: "因此，惊悚、复仇剧、丧尸片等新类型呈爆发式增长。" }, { ko: "주인공은 가족을 잃은 뒤 복수를 결심한다.", zh: "主人公失去家人后决心复仇。" }] },
    { word: '좀비', meaning: '丧尸', pronunciation: '', examples: [{ ko: "한 좀비 드라마는 전 세계적으로 흥행에 성공하며 한국 콘텐츠의 위상을 높였다.", zh: "一部丧尸剧在全球范围内取得票房成功，提升了韩国内容的地位。" }, { ko: "이 작품은 좀비를 소재로 한 최초의 사극이다.", zh: "这部作品是首部以丧尸为题材的古装剧。" }] },
    { word: '직장', meaning: '职场', pronunciation: '', examples: [{ ko: "직장 내의 경쟁과 부조리를 사실적으로 그린 작품도 큰 호응을 얻었다.", zh: "真实描绘职场竞争与不公的作品也获得了极大的反响。" }, { ko: "그는 새로운 직장에 적응하느라 무척 바빴다.", zh: "他为了适应新职场忙得不可开交。" }] },
    { word: '플랫폼', meaning: '平台', pronunciation: '', examples: [{ ko: "특히 넷플릭스와 같은 OTT 플랫폼의 등장으로 인해 제작 환경이 크게 달라졌다.", zh: "尤其是由于奈飞等 OTT 平台的出现，制作环境发生了巨大的改变。" }, { ko: "여러 플랫폼이 경쟁하면서 콘텐츠의 질이 높아졌다.", zh: "随着多个平台竞争，内容质量提高了。" }] },
    { word: '제작', meaning: '制作', pronunciation: '', examples: [{ ko: "특히 넷플릭스와 같은 OTT 플랫폼의 등장으로 인해 제작 환경이 크게 달라졌다.", zh: "尤其是由于奈飞等 OTT 平台的出现，制作环境发生了巨大的改变。" }, { ko: "이 드라마는 제작에만 삼 년이 걸렸다.", zh: "这部剧仅制作就花了三年。" }] },
    { word: '소재', meaning: '题材', pronunciation: '', examples: [{ ko: "그러나 시청자의 취향이 다양해짐에 따라 새로운 소재가 요구되기 시작했다.", zh: "然而，随着观众口味的多样化，人们开始要求新的题材。" }, { ko: "작가는 일상적인 소재에서 이야기의 영감을 얻는다.", zh: "作家从日常题材中获得故事灵感。" }] },
    { word: '흥행', meaning: '卖座、票房成功', pronunciation: '', examples: [{ ko: "한 좀비 드라마는 전 세계적으로 흥행에 성공하며 한국 콘텐츠의 위상을 높였다.", zh: "一部丧尸剧在全球范围内取得票房成功，提升了韩国内容的地位。" }, { ko: "그 영화는 개봉 첫 주에 흥행 기록을 세웠다.", zh: "那部电影在上映首周创下了票房纪录。" }] },
    { word: '시청자', meaning: '观众', pronunciation: '', examples: [{ ko: "이는 국내 시청자뿐만 아니라 해외 시청자까지 겨냥한 전략으로 볼 수 있다.", zh: "这可以看作是不仅面向国内观众，也瞄准海外观众的战略。" }, { ko: "제작진은 시청자의 반응을 실시간으로 확인했다.", zh: "制作方实时关注了观众的反应。" }] },
