  id: 'korean-travel-philosophy',
  title: '旅行究竟意味着什么',
  titleKo: '여행이란 무엇인가',
  emoji: '🧭',
  level: 'C2',
  topic: '旅行',
  estimatedMinutes: 20,
  learningGoals: [
    '掌握「관광」「타자성」「일상성」等旅行哲学层面的高级抽象词与汉字词',
    '理解并运用 C2 사색 에세이的定义句式、名词化与长复句论证结构',
    '辨析「打卡式观光」与「作为自我重塑的旅行」之间的思辨脉络',
    '能就旅行的意义组织有立场、有层次的长篇韩语思辨论述',
  ],
  coreWords: [
    { word: '여행', meaning: '旅行', pronunciation: '', examples: [{ ko: "여행이란, 낯선 곳으로 몸을 옮기는 단순한 이동이 아니라 익숙한 자기 자신으로부터 잠시 거리를 두는 하나의 사건이다.", zh: "所谓旅行，并非把身体挪往陌生之地的简单位移，而是暂时与熟悉的自我拉开距离的一桩事件。" }, { ko: "진정한 여행은 목적지에 도착하는 순간이 아니라, 달라진 눈으로 일상에 돌아오는 순간에 완성된다.", zh: "真正的旅行并非在抵达目的地的那一刻，而是在以改变了的目光回归日常的那一瞬间才得以完成。" }] },
    { word: '관광', meaning: '观光、游览（消费式的看景）', pronunciation: '', examples: [{ ko: "많은 이들이 여행이라 부르는 것은 실은 명소를 빠짐없이 지나가며 사진 한 장을 남기는 관광에 가깝다.", zh: "许多人称之为旅行的东西，其实更接近于逐一掠过名胜、只留下一张照片的观光。" }, { ko: "관광이 장소를 소비의 대상으로 삼는다면, 여행은 그 장소 앞에서 자신을 되묻게 한다.", zh: "如果说观光把地方当作消费的对象，那么旅行则让人在那个地方面前反问自己。" }] },
    { word: '일상', meaning: '日常', pronunciation: '', examples: [{ ko: "우리는 일상 속에서 수많은 역할과 관계에 파묻힌 나머지, 정작 자신이 무엇을 원하는지조차 묻지 못한다.", zh: "在日常之中，我们被无数角色与关系所淹没，以至于连自己究竟想要什么都无从追问。" }, { ko: "일상은 익숙함이라는 이름으로 우리의 시야를 서서히 좁혀 간다.", zh: "日常以「熟悉」之名，悄然逐渐收窄着我们的视野。" }] },
    { word: '타자', meaning: '他者、他人', pronunciation: '', examples: [{ ko: "여행은 편안한 습관을 무너뜨리고 우리를 끊임없이 타자와 마주 서게 만든다.", zh: "旅行瓦解安逸的习惯，不断地让我们与他者面对面地站在一处。" }, { ko: "타자를 이해하려는 노력은 결국 나 자신의 한계를 응시하는 일로 이어진다.", zh: "试图理解他者的努力，归根结底会通向凝视自身局限这件事。" }] },
    { word: '타자성', meaning: '他者性（与我截然不同的存在特质）', pronunciation: '', examples: [{ ko: "타자성이란 나와 다른 존재가 지닌 낯섦 그 자체이며, 그 낯섦은 나의 좁은 시야를 흔든다.", zh: "所谓他者性，正是与我相异的存在所持有的陌生本身，而那份陌生动摇着我狭窄的视野。" }, { ko: "타자성과의 만남은 나의 세계가 유일한 정답이 아님을 조용히 일깨운다.", zh: "与他者性的相遇，静静地提醒我：我的世界并非唯一的正解。" }] },
    { word: '거리두기', meaning: '拉开距离、保持距离', pronunciation: '', examples: [{ ko: "일상으로부터의 거리두기는 나를 둘러싼 것들을 처음 보듯 다시 바라보게 하는 성찰의 조건이 된다.", zh: "与日常拉开距离，便成为使我们如初见般重新凝望环绕自身之物的省察条件。" }, { ko: "익숙한 것과의 거리두기 없이는, 우리는 자신의 삶을 객관적으로 성찰하기 어렵다.", zh: "若不与熟悉之物拉开距离，我们便难以客观地省察自己的人生。" }] },
    { word: '체험', meaning: '体验、亲历', pronunciation: '', examples: [{ ko: "낯섦을 배움의 기회로 받아들일 수 있을 때, 이동은 소비를 넘어 진정한 체험으로 승화한다.", zh: "当我们能把陌生当作学习的契机来接纳时，位移便超越消费，升华为真正的体验。" }, { ko: "화면 너머로 구경하는 것과 몸으로 부딪치며 겪는 체험 사이에는 건널 수 없는 간극이 있다.", zh: "隔着屏幕观看，与用身体去碰撞、亲历的体验之间，横亘着一道无法逾越的鸿沟。" }] },
    { word: '소비', meaning: '消费', pronunciation: '', examples: [{ ko: "관광에서 낯선 도시는 목록을 채우고 소비하기 위한 하나의 상품으로 전락하기 마련이다.", zh: "在观光里，陌生的城市难免沦为一件用来填满清单、加以消费的商品。" }, { ko: "여행이 단순한 소비에 그친다면, 우리는 장소를 지나칠 뿐 그것과 진정으로 만나지는 못한다.", zh: "倘若旅行止于单纯的消费，我们便只是掠过一个个地方，而无法与它真正相遇。" }] },
    { word: '풍경', meaning: '风景', pronunciation: '', examples: [{ ko: "풍경을 눈에 담기도 전에 화면 속에 먼저 담아 두려는 태도는 그 장소를 마주하는 경험 자체를 대체해 버린다.", zh: "还未及把风景收入眼底，便急于先将它收进屏幕——这种姿态取代了面对那个地方的经验本身。" }, { ko: "같은 풍경이라도 어떤 마음으로 바라보느냐에 따라 전혀 다른 의미로 다가온다.", zh: "即便是同一片风景，也会因以怎样的心境去凝望，而以截然不同的意义向人逼近。" }] },
    { word: '성찰', meaning: '省察、反思', pronunciation: '', examples: [{ ko: "모든 여행이 이러한 성찰로 이어지는 것은 아니며, 익숙한 편안함만을 좇는다면 그 여정은 관광에 머문다.", zh: "并非所有旅行都会通向这样的省察；倘若只一味追逐熟悉的安逸，那趟旅程便停留在观光。" }, { ko: "깊은 성찰은 답을 서둘러 내리기보다 스스로에게 던지는 물음 속에서 천천히 자란다.", zh: "深刻的省察，与其急于给出答案，不如在向自身抛出的追问之中缓缓生长。" }] },
    { word: '낯섦', meaning: '陌生（感）', pronunciation: '', examples: [{ ko: "타자성이란 나와 다른 존재가 지닌 낯섦 그 자체이며, 그 낯섦은 나의 좁은 시야를 흔들어 새로운 물음을 던지게 한다.", zh: "所谓他者性，正是与我相异的存在所持有的陌生本身；那份陌生动摇我狭窄的视野，逼我抛出崭新的问题。" }, { ko: "낯섦을 두려워하지 않고 마주할 때, 우리는 비로소 익숙함이 가려 온 것들을 보게 된다.", zh: "唯有不惧陌生、坦然面对时，我们才终于看见那些被熟悉所遮蔽之物。" }] },
    { word: '정체성', meaning: '认同、自我认识', pronunciation: '', examples: [{ ko: "참된 여행은 새로운 풍경을 눈에 담는 데 그치지 않고, 그 풍경을 통해 자신의 정체성을 다시 쓰는 과정이다.", zh: "真正的旅行不止步于把新风景收入眼底，而是借由那片风景重新改写自我认识的过程。" }, { ko: "정체성은 한번 정해지면 고정되는 것이 아니라, 낯선 경험 속에서 끊임없이 다시 쓰이는 것이다.", zh: "认同并非一经确定便固定不变，而是在陌生的经验之中被不断地重新书写。" }] },
    { word: '이방인', meaning: '异乡人、外来者', pronunciation: '', examples: [{ ko: "낯선 언어와 규칙 앞에서 이방인이 된다는 것은, 당연하게 여기던 자신의 세계가 유일한 세계가 아님을 깨닫는 일이다.", zh: "在陌生的语言与规则面前成为异乡人，意味着领悟到自己视为理所当然的世界并非唯一的世界。" }, { ko: "잠시 이방인이 되어 보아야 비로소 자기 문화의 윤곽이 바깥에서 또렷이 보인다.", zh: "唯有暂且成为一回异乡人，自身文化的轮廓才会从外部清晰地显现出来。" }] },
    { word: '귀환', meaning: '归返、回归', pronunciation: '', examples: [{ ko: "진정한 여행의 완성은 낯선 땅에 도착하는 순간이 아니라, 달라진 눈으로 자신의 일상으로 귀환하는 그 순간에 있다.", zh: "真正旅行的完成，并不在抵达陌生土地的那一刻，而在以改变了的目光归返自身日常的那一瞬。" }, { ko: "여행의 진정한 의미는 떠남이 아니라 귀환의 순간, 달라진 자신을 확인하는 데에서 드러난다.", zh: "旅行真正的意义，不在于出发，而在归返的瞬间——在确认那个已然改变的自己之中显露出来。" }] },
  ],
  grammarIds: ['g21', 'g47', 'g49', 'g54', 'g83'],
  sentences: [
    {
      id: "s1",
      ko: "주말 오전 6시, 인천공항 제1터미널은 이미 북새통이었다. 도쿄행, 방콕행, 다낭행 줄이 꼬리를 물었다.",
      zh: "周末早上六点，仁川机场第一航站楼已经人山人海。东京、曼谷、岘港的队伍排成了长龙。",
      pronunciation: "jumal ojeon 6si, incheongonghang je1teomineoreun imi buksaetongieotda. dokyohaeng, bangkokaeng, dananghaeng juri kkorireul mureotda.",
      words: [{"word":"북새통","meaning":"人山人海/混乱"},{"word":"꼬리를 물다","meaning":"排长龙/接踵"}],
      grammarIds: [],
      difficulty: "easy",
    },
    {
      id: "s2",
      ko: "한국인은 여행도 '빨리빨리' 한다. 3박 4일 일정에 관광지 15곳을 찍고 오는 건 예삿일이다.",
      zh: "韩国人连旅行都\"快快快\"。四天三晚日程里打卡15个景点，是家常便饭。",
      pronunciation: "hangugineun yeohaengdo 'ppalrippalri' handa. 3bak 4il iljeonge gwangwangji 15goseul jjikgo oneun geon yesasirida.",
      words: [{"word":"빨리빨리","meaning":"快快快（韩国文化符号）"},{"word":"찍다","meaning":"打卡/拍照"},{"word":"예삿일","meaning":"家常便饭"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s3",
      ko: "전 직장 동료였던 이모 씨(34)는 작년 오사카 여행에서 하루 평균 28,000보를 걸었다며 자랑했다.",
      zh: "前同事李某（34岁）自豪地说，去年的日本大阪旅行平均每天走了28000步。",
      pronunciation: "jeon jikjang dongryoyeotdeon imo ssi(34)neun jangnyeon osaka yeohaengeseo haru pyeonggyun 28,000boreul georeotdamyeo jaranghaetda.",
      words: [{"word":"직장 동료","meaning":"同事"},{"word":"평균","meaning":"平均"},{"word":"자랑하다","meaning":"炫耀/自豪地说"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s4",
      ko: "스마트폰을 꺼내 구글 지도에 별표 찍어 둔 맛집 리스트를 보여 주는데, 사흘 동안 21곳이었다.",
      zh: "他掏出手机给我看谷歌地图上打了星的餐厅清单，三天之内...21家。",
      pronunciation: "seumateuponeul kkeonae gugeul jidoe byeolpyo jjigeo dun matjip riseuteureul boyeo juneunde, saheul dongan 21gosieotda.",
      words: [{"word":"별표","meaning":"星标"},{"word":"맛집","meaning":"美食店"},{"word":"사흘","meaning":"三天"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s5",
      ko: "이게 진짜 여행일까. 체크리스트를 지워 가는 일과, 낯선 거리를 헤매다 길을 잃는 일 중 어느 쪽이 여행에 가까울까.",
      zh: "这真的是旅行吗？一个是一个个划掉清单项目，一个是在陌生街道迷路——哪一个更接近旅行？",
      pronunciation: "ige jinjja yeohaengilkka. chekeuriseuteureul jiwo ganeun ilgwa, natseon georireul hemaeda gireul ilneun il jung eoneu jjogi yeohaenge gakkaulkka.",
      words: [{"word":"체크리스트","meaning":"清单"},{"word":"헤매다","meaning":"徘徊/迷路"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s6",
      ko: "SNS에는 '인증샷'이 넘쳐난다. 에펠탑 앞에서 손가락 브이, 시부야 횡단보도에서 브이. 배경만 바뀔 뿐 포즈는 똑같다.",
      zh: "社交媒体上满是\"认证照\"。埃菲尔铁塔前比V、涩谷人行横道上比V——背景在变，姿势永远一样。",
      pronunciation: "SNSeneun 'injeungsyat'i neomchyeonanda. epeltap apeseo songarak beui, sibuya hoengdanbodoeseo beui. baegyeongman bakkwil ppun pojeuneun ttokgatda.",
      words: [{"word":"인증샷","meaning":"认证照/打卡照"},{"word":"넘쳐나다","meaning":"泛滥/充斥"},{"word":"횡단보도","meaning":"人行横道"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s7",
      ko: "어떤 장소에 도착해서 가장 먼저 하는 일이 카메라를 켜는 것이라면, 그곳에 정말 '도착'한 걸까.",
      zh: "如果抵达一个地方做的第一件事是打开相机，那真的算\"抵达\"了那里吗？",
      pronunciation: "eotteon jangsoe dochakaeseo gajang meonjeo haneun iri kamerareul kyeoneun geosiramyeon, geugose jeongmal 'dochak'han geolkka.",
      words: [{"word":"도착하다","meaning":"抵达"},{"word":"카메라를 켜다","meaning":"打开相机"}],
      grammarIds: [],
      difficulty: "easy",
    },
    {
      id: "s8",
      ko: "교토의 한 사찰은 지난해부터 '사진 금지 구역'을 지정했다. 촬영에 몰두하느라 정작 참배를 안 한다는 이유에서였다.",
      zh: "京都一家寺院从去年开始指定了\"禁止拍照区域\"。理由是游客只顾着拍照，根本不来参拜。",
      pronunciation: "gyotoui han sachareun jinanhaebuteo 'sajin geumji guyeok'eul jijeonghaetda. chwaryeonge molduhaneura jeongjak chambaereul an handaneun iyueseoyeotda.",
      words: [{"word":"사찰","meaning":"寺院"},{"word":"구역","meaning":"区域"},{"word":"몰두하다","meaning":"埋头/沉迷"},{"word":"참배","meaning":"参拜"}],
      grammarIds: [],
      difficulty: "hard",
    },
    {
      id: "s9",
      ko: "한국인의 여행에는 '정상 인증'이라는 독특한 문화가 있다. 산 정상에서 찍은 사진은 등산객에게 하나의 트로피나 다름없다.",
      zh: "韩国人的旅行里有一种叫\"登顶认证\"的独特文化。山顶上拍的照片，对登山客来说无异于一座奖杯。",
      pronunciation: "hanguginui yeohaengeneun 'jeongsang injeung'iraneun dokteukan munhwaga itda. san jeongsangeseo jjigeun sajineun deungsangaegege hanaui teuropina dareumeopda.",
      words: [{"word":"정상","meaning":"山顶"},{"word":"인증","meaning":"认证"},{"word":"트로피","meaning":"奖杯"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s10",
      ko: "제주 한라산 백록담에서는 해마다 수천 장의 똑같은 구도 사진이 생산된다. 누구의 인스타그램에 올라가도 구분이 안 될 만큼 닮았다.",
      zh: "在济州汉拿山白鹿潭，每年有数千张构图完全相同的照片产生。像到无论发在谁的Instagram上都分辨不出来。",
      pronunciation: "jeju hallasan baengnokdameseoneun haemada sucheon jangui ttokgateun gudo sajini saengsandoenda. nuguui inseutageuraeme olragado gubuni an doel mankeum dalmatda.",
      words: [{"word":"구도","meaning":"构图"},{"word":"생산되다","meaning":"被生产"},{"word":"구분","meaning":"区分"}],
      grammarIds: [],
      difficulty: "hard",
    },
    {
      id: "s11",
      ko: "등산 앱 '트랭글'의 이용자 수는 2023년 800만 명을 돌파했다. 정상 인증 배지를 모으는 재미가 사람을 산으로 이끈다.",
      zh: "登山应用\"Tranggle\"的用户数在2023年突破了800万。收集登顶认证徽章的乐趣把人引向山里。",
      pronunciation: "deungsan aep 'teuraenggeul'ui iyongja suneun 2023nyeon 800man myeongeul dolpahaetda. jeongsang injeung baejireul moeuneun jaemiga sarameul saneuro ikkeunda.",
      words: [{"word":"돌파하다","meaning":"突破"},{"word":"배지","meaning":"徽章"},{"word":"이끌다","meaning":"引导/牵引"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s12",
      ko: "그런데 요즘 젊은 층에서 조금 다른 바람이 분다. 아무것도 안 하는 여행, 이른바 '호캉스'다.",
      zh: "但最近年轻人圈子里吹着一股不一样的风。什么都不做的旅行，所谓\"酒店度假\"。",
      pronunciation: "geureonde yojeum jeolmeun cheungeseo jogeum dareun barami bunda. amugeotdo an haneun yeohaeng, ireunba 'hokangseu'da.",
      words: [{"word":"젊은 층","meaning":"年轻群体"},{"word":"호캉스","meaning":"酒店度假（hotel+vacance）"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s13",
      ko: "시그니엘 서울 1박 요금은 50만 원대부터 시작한다. 주말이면 예약이 꽉 찬다. 객실에서 침대만 바라보는 여행이다.",
      zh: "Signiel首尔一晚价格从50万韩元起。到了周末预约全满。就是一种在客房里只盯着床看的旅行。",
      pronunciation: "sigeuniel seoul 1bak yogeumeun 50man wondaebuteo sijakanda. jumarimyeon yeyagi kkwak chanda. gaeksireseo chimdaeman baraboneun yeohaengida.",
      words: [{"word":"1박","meaning":"一晚"},{"word":"요금","meaning":"费用/价格"},{"word":"객실","meaning":"客房"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s14",
      ko: "'빨리빨리'에 지친 사람이 늘고 있다는 신호다. 가만히 있는 것도 하나의 사치가 된 시대다.",
      zh: "这是被\"快快快\"文化耗尽精力的人越来越多的信号。连\"安静待着\"都成了一种奢侈的时代。",
      pronunciation: "'ppalrippalri'e jichin sarami neulgo itdaneun sinhoda. gamanhi itneun geotdo hanaui sachiga doen sidaeda.",
      words: [{"word":"지치다","meaning":"疲惫/耗尽"},{"word":"가만히 있다","meaning":"安静待着"},{"word":"사치","meaning":"奢侈"}],
      grammarIds: [],
      difficulty: "medium",
    },
    {
      id: "s15",
