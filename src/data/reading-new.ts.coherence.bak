      { word: '방송국', meaning: '电视台', pronunciation: '', examples: [{ ko: "방송국은 광고 수익을 올리는 한편 스트리밍 플랫폼과도 계약해요.", zh: "电视台在提高广告收益的同时，也与流媒体平台签约。" }, { ko: "그 방송국은 주말마다 새 드라마를 방영해요.", zh: "那家电视台每逢周末播放新剧。" }] },
      { word: '스트리밍', meaning: '流媒体/Streaming', pronunciation: '', examples: [{ ko: "스트리밍 서비스는 드라마를 제공하는 한편 데이터를 분석해 새로운 콘텐츠도 개발해요.", zh: "流媒体服务在提供电视剧的同时，也分析数据开发新内容。" }, { ko: "요즘은 스트리밍으로 드라마를 보는 사람이 많아요.", zh: "现在很多人用流媒体看剧。" }] },
      { word: '촬영', meaning: '拍摄', pronunciation: '', examples: [{ ko: "촬영 팀은 세트를 짓는 한편 야외 촬영 장소도 준비해요.", zh: "拍摄团队在搭建布景的同时，也准备户外拍摄地点。" }, { ko: "이 장면은 제주도에서 촬영했어요.", zh: "这个场景是在济州岛拍摄的。" }] },
      { word: '각본', meaning: '剧本', pronunciation: '', examples: [{ ko: "각본 작가는 대본을 쓰는 한편 제작사와 수정 작업도 진행해요.", zh: "剧本作家在写剧本的同时，也与制作公司进行修改工作。" }, { ko: "탄탄한 각본이 드라마 성공의 핵심이에요.", zh: "扎实的剧本是电视剧成功的核心。" }] },
      { word: '시청자', meaning: '观众', pronunciation: '', examples: [{ ko: "제작비가 올라가는 한편 시청자들의 눈높이도 높아지고 있어요.", zh: "在制作费上涨的同时，观众的眼光也在提高。" }, { ko: "시청자들의 반응이 아주 뜨거웠어요.", zh: "观众的反响非常热烈。" }] },
      { word: '수익', meaning: '收益/收入', pronunciation: '', examples: [{ ko: "글로벌 진출은 수익을 높일 뿐만 아니라 브랜드 인지도도 높여요.", zh: "全球进军不仅能提高收益，还能提升品牌知名度。" }, { ko: "이 작품은 해외 판권으로 큰 수익을 올렸어요.", zh: "这部作品靠海外版权获得了可观的收益。" }] },
      { word: '협찬', meaning: '赞助/植入广告', pronunciation: '', examples: [{ ko: "드라마는 시청률을 높일 뿐만 아니라 협찬 수익도 가져다줘요.", zh: "电视剧不仅能提高收视率，还能带来赞助收益。" }, { ko: "드라마 속 제품은 대부분 협찬을 받은 거예요.", zh: "剧中出现的产品大多是获得赞助的。" }] },
      { word: '제작비', meaning: '制作费', pronunciation: '', examples: [{ ko: "제작비가 올라가는 한편 시청자들의 눈높이도 높아지고 있어요.", zh: "在制作费上涨的同时，观众的眼光也在提高。" }, { ko: "요즘 드라마는 제작비가 영화 못지않아요.", zh: "如今电视剧的制作费不亚于电影。" }] },
      { word: '글로벌 진출', meaning: '全球进军', pronunciation: '', examples: [{ ko: "글로벌 진출은 수익을 높일 뿐만 아니라 브랜드 인지도도 높여요.", zh: "全球进军不仅能提高收益，还能提升品牌知名度。" }, { ko: "이 회사는 글로벌 진출을 목표로 하고 있어요.", zh: "这家公司以全球进军为目标。" }] },
      { word: '인기를 끌다', meaning: '引发人气', pronunciation: '', examples: [{ ko: "한국 드라마는 아시아뿐만 아니라 전 세계에서 인기를 끌어요.", zh: "韩国电视剧不仅在亚洲，在全世界都引发人气。" }, { ko: "그 배우는 데뷔하자마자 큰 인기를 끌었어요.", zh: "那位演员一出道就大受欢迎。" }] },
      { word: '흥행하다', meaning: '大卖/卖座', pronunciation: '', examples: [{ ko: "흥행한 드라마는 시즌 2를 제작할 뿐만 아니라 영화로도 만들어져요.", zh: "卖座的电视剧不仅会制作第2季，还会被改编为电影。" }, { ko: "그 영화는 개봉 첫 주부터 크게 흥행했어요.", zh: "那部电影从上映首周就大卖。" }] },
    ],
    grammarIds: ['g38', 'g55', 'g49', 'g20', 'g83'],
    grammarCardIds: ['card-p23-l06', 'card-p23-l08', 'card-p8-l04', 'card-p13-l03'],
    sentences: [
      {
        id: "s1",
        ko: "2024년 12월, 경기도 고양시의 한 드라마 세트장을 찾았다.",
        zh: "2024年12月，我去了京畿道高阳市的一个电视剧拍摄棚。",
        pronunciation: "2024nyeon 12wol, gyeonggido goyangsiui han deurama seteujangeul chajatda.",
        words: [{ word: "세트장", meaning: "拍摄棚，摄影棚" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s2",
        ko: "밤 11시가 넘었는데도 스태프 50여 명이 분주하게 움직이고 있었다.",
        zh: "已经过了晚上11点，五十多名工作人员还在忙碌地穿梭着。",
        pronunciation: "bam 11siga neomeotneundedo seutaepeu 50yeo myeongi bunjuhage umjigigo isseotda.",
        words: [{ word: "스태프", meaning: "工作人员" }, { word: "분주하다", meaning: "忙碌，奔走" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s3",
        ko: "\"오늘 새벽 3시까지 찍어야 내일 편집실로 넘길 수 있어요.\" 조감독의 목소리가 지쳐 있었다.",
        zh: "\"今天得拍到凌晨3点，明天才能交到剪辑室。\"助理导演的声音透着疲惫。",
        pronunciation: "\"oneul saebyeok 3sikkaji jjigeoya naeil pyeonjipsilro neomgil su isseoyo.\" jogamdogui moksoriga jichyeo isseotda.",
        words: [{ word: "조감독", meaning: "助理导演" }, { word: "편집실", meaning: "剪辑室" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s4",
        ko: "이날 촬영 중인 드라마는 회당 제작비 8억 원짜리 대작이다.",
        zh: "当天正在拍摄的是一部单集制作费8亿韩元的大制作。",
        pronunciation: "inal chwaryeong jungin deuramaneun hoedang jejakbi 8eok wonjjari daejagida.",
        words: [{ word: "회당", meaning: "每集" }, { word: "대작", meaning: "大制作，大片" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s5",
        ko: "주연 배우 개런티만 회당 2억 원, 전체 제작비의 4분의 1을 차지한다.",
        zh: "光主演片酬每集就2亿韩元，占全部制作费的四分之一。",
        pronunciation: "juyeon baeu gaereontiman hoedang 2eok won, jeonche jejakbiui 4bunui 1eul chajihanda.",
        words: [{ word: "개런티", meaning: "片酬，出场费" }, { word: "차지하다", meaning: "占据" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s6",
        ko: "한국 드라마 제작 현장의 가장 큰 특징은 '생방송 수준'의 촬영 스케줄이다.",
        zh: "韩剧制作现场最大的特点就是\"直播级别\"的拍摄日程。",
        pronunciation: "hanguk deurama jejak hyeonjangui gajang keun teukjingeun 'saengbangsong sujun'ui chwaryeong seukejurida.",
        words: [{ word: "생방송", meaning: "直播" }, { word: "스케줄", meaning: "日程，排期" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s7",
        ko: "대본이 4회분밖에 안 나온 상태에서 첫 방송을 시작하는 일도 드물지 않다.",
        zh: "剧本只出了四集的分量就开始首播，这种事并不少见。",
        pronunciation: "daeboni 4hoebunbakke an naon sangtaeeseo cheot bangsongeul sijakaneun ildo deumulji anda.",
        words: [{ word: "대본", meaning: "剧本" }, { word: "드물지 않다", meaning: "并不少见" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s8",
        ko: "시청자 반응을 보고 남은 회차의 대본을 수정하는 건 이제 업계의 기본 동작이다.",
        zh: "看观众反应来修改剩余集数的剧本，这已经是业界的基本操作了。",
        pronunciation: "sicheongja baneungeul bogo nameun hoechaui daeboneul sujeonghaneun geon ije eopgyeui gibon dongjagida.",
        words: [{ word: "시청자", meaning: "观众" }, { word: "수정하다", meaning: "修改" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s9",
        ko: "넷플릭스가 2016년 한국에 진입한 뒤로 판은 완전히 뒤집혔다.",
        zh: "Netflix 2016年进入韩国后，局面彻底翻盘了。",
        pronunciation: "netpeulrikseuga 2016nyeon hanguge jinipan dwiro paneun wanjeonhi dwijipyeotda.",
        words: [{ word: "뒤집히다", meaning: "被颠覆，翻盘" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s10",
        ko: "예전에는 지상파 3사 편성만 받으면 성공이었지만, 이제는 글로벌 조회수가 더 큰 변수다.",
        zh: "以前拿到三大无线台的排播档期就算成功，现在全球播放量才是更大的变量。",
        pronunciation: "yejeoneneun jisangpa 3sa pyeonseongman bajeumyeon seonggongieotjiman, ijeneun geulrobeol johoesuga deo keun byeonsuda.",
        words: [{ word: "지상파", meaning: "无线电视台，地面波" }, { word: "변수", meaning: "变量，变数" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s11",
        ko: "'오징어 게임' 시즌1 제작비는 약 250억 원. 당시로서는 파격적인 규모였다.",
        zh: "《鱿鱼游戏》第一季制作费约250亿韩元。在当时算是破格的规模。",
        pronunciation: "'ojingeo geim' sijeun1 jejakbineun yak 250eok won. dangsiroseoneun pagyeokjeogin gyumoyeotda.",
        words: [{ word: "파격적", meaning: "破格的，打破常规的" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s12",
        ko: "결과는 넷플릭스 사상 최고 시청 기록. 이 한 작품이 한국 드라마의 글로벌 위상을 바꿔 놓았다.",
        zh: "结果创下了Netflix史上最高收视纪录。这一部作品就改变了韩剧的全球地位。",
        pronunciation: "gyeolgwaneun netpeulrikseu sasang choego sicheong girok. i han jakpumi hanguk deuramaui geulrobeol wisangeul bakkwo nohatda.",
        words: [{ word: "위상", meaning: "地位，声望" }, { word: "바꿔 놓다", meaning: "改变（结果持续）" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s13",
        ko: "흥행작의 OST도 무시 못 할 수입원이다.",
        zh: "热门作品的OST也是不可忽视的收入来源。",
        pronunciation: "heunghaengjagui OSTdo musi mot hal suibwonida.",
        words: [{ word: "흥행작", meaning: "热门作品，卖座作品" }, { word: "수입원", meaning: "收入来源" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s14",
        ko: "'선재 업고 튀어' OST는 발매 첫 주에만 30만 건 넘게 스트리밍됐다.",
        zh: "《背着善宰跑》的OST仅发行第一周就突破了30万次播放。",
        pronunciation: "'seonjae eopgo twieo' OSTneun balmae cheot jueman 30man geon neomge seuteurimingdwaetda.",
        words: [{ word: "발매", meaning: "发行，发售" }, { word: "스트리밍되다", meaning: "被播放，流媒体播放" }],
