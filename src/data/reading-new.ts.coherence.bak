      { word: '복지', meaning: '福利', pronunciation: '', examples: [{ ko: "노인 복지를 비롯한 사회 보장 제도에 대한 재정 부담이 증가하고 있습니다.", zh: "包括老人福利在内的社会保障制度的财政负担正在增加。" }, { ko: "탄탄한 복지 제도는 사회 안전망의 핵심이다.", zh: "完善的福利制度是社会安全网的核心。" }] },
      { word: '연금', meaning: '养老金', pronunciation: '', examples: [{ ko: "국민연금 고갈 문제는 미래 세대에게 심각한 불안 요인이 되고 있습니다.", zh: "国民养老金枯竭问题正成为未来世代严重的不安因素。" }, { ko: "노후에 안정적인 연금을 받으려면 젊을 때부터 준비해야 한다.", zh: "要想晚年领取稳定的养老金，就得从年轻时开始准备。" }] },
      { word: '의료비', meaning: '医疗费用', pronunciation: '', examples: [{ ko: "의료비 지출이 늘어나면서 건강보험 재정도 압박을 받고 있습니다.", zh: "随着医疗费用支出增加，医疗保险财政也承受着压力。" }, { ko: "고령 인구가 늘수록 의료비 부담은 가중될 수밖에 없다.", zh: "老龄人口越增加，医疗费用负担就必然加重。" }] },
      { word: '생산 인구', meaning: '生产人口', pronunciation: '', examples: [{ ko: "저출생과 고령화의 동시 진행으로 생산 가능 인구가 빠르게 줄고 있습니다.", zh: "低出生率与老龄化同步推进，生产年龄人口正在快速减少。" }, { ko: "생산 인구 감소는 경제 성장의 발목을 잡는 요인이다.", zh: "生产人口减少是拖累经济增长的因素。" }] },
      { word: '부양', meaning: '赡养/抚养', pronunciation: '', examples: [{ ko: "젊은 세대의 노인 부양 부담이 점점 커지면서 세대 간 갈등도 심화되고 있습니다.", zh: "随着年轻一代赡养老人的负担越来越重，代际矛盾也在加剧。" }, { ko: "한 명의 젊은이가 부양해야 할 노인의 수가 점점 늘고 있다.", zh: "一名年轻人需要赡养的老人数量正逐渐增加。" }] },
      { word: '초고령 사회', meaning: '超老龄社会', pronunciation: '', examples: [{ ko: "2025년에는 65세 이상 인구가 전체의 20%를 넘는 초고령 사회에 진입할 전망입니다.", zh: "预计2025年将进入65岁以上人口超过总人口20%的超老龄社会。" }, { ko: "초고령 사회에 대비한 사회 시스템 개편이 시급하다.", zh: "为应对超老龄社会，改革社会系统迫在眉睫。" }] },
      { word: '재정', meaning: '财政', pronunciation: '', examples: [{ ko: "노인 복지를 비롯한 사회 보장 제도에 대한 재정 부담이 증가하고 있습니다.", zh: "包括老人福利在内的社会保障制度的财政负担正在增加。" }, { ko: "복지 지출이 늘면서 국가 재정에 대한 우려가 커지고 있다.", zh: "随着福利支出增加，对国家财政的忧虑正在扩大。" }] },
      { word: '이민', meaning: '移民', pronunciation: '', examples: [{ ko: "일부 전문가들은 이민 정책 완화가 인구 문제 해결에 도움이 될 수 있다고 주장합니다.", zh: "部分专家主张，放宽移民政策有助于解决人口问题。" }, { ko: "적극적인 이민 정책으로 부족한 노동력을 보충하는 나라도 있다.", zh: "也有国家通过积极的移民政策来补充不足的劳动力。" }] },
      { word: '출산율', meaning: '出生率', pronunciation: '', examples: [{ ko: "하지만 높은 주거비와 교육비로 인해 출산율은 좀처럼 회복되지 않고 있습니다.", zh: "但由于高昂的住房费和教育费，出生率迟迟无法回升。" }, { ko: "각종 지원책에도 불구하고 출산율은 해마다 최저치를 경신하고 있다.", zh: "尽管有各种支援政策，出生率仍逐年刷新最低纪录。" }] },
    ],
    grammarIds: ['g54', 'g49', 'g30', 'g78', 'g67'],
    grammarCardIds: ['card-p20-l02', 'card-p29-l03', 'card-p10-l04', 'card-p25-l01'],
    sentences: [
      {
        id: "s1",
        ko: "지난 3월 14일 오전, 서울 노원구의 한 노인복지관을 찾았다.",
        zh: "3月14日上午，来到首尔芦原区一家老人福利馆。",
        pronunciation: "jinan 3wol 14il ojeon, seoul nowonguui han noinbokjigwaneul chajatda.",
        words: [{ word: "노원구", meaning: "芦原区" }, { word: "노인복지관", meaning: "老人福利馆" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s2",
        ko: "로비에 들어서자 스마트폰 수업을 기다리는 노인 20여 명이 삼삼오오 앉아 있었다.",
        zh: "一进大厅，就看到20多位老人三五成群地坐着等智能手机课开课。",
        pronunciation: "robie deureoseoja seumateupon sueobeul gidarineun noin 20yeo myeongi samsamoo anja isseotda.",
        words: [{ word: "삼삼오오", meaning: "三五成群" }, { word: "수업", meaning: "课程" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s3",
        ko: "수강생 평균 연령은 78세, 강사는 스물셋 대학생 자원봉사자였다.",
        zh: "学员平均年龄78岁，讲师是个23岁的大学生志愿者。",
        pronunciation: "sugangsaeng pyeonggyun yeollyeongeun 78se, gangsaneun seumulset daehaksaeng jawonbongsajayeotda.",
        words: [{ word: "수강생", meaning: "学员" }, { word: "연령", meaning: "年龄" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s4",
        ko: "한 어르신이 내게 '손주한테서 사진 받는 법을 배우러 왔다'고 했다.",
        zh: "一位老人对我说：\"我来学怎么收孙子发来的照片。\"",
        pronunciation: "han eoreusini naege 'sonjuhanteseo sajin banneun beobeul baeureo watda'go haetda.",
        words: [{ word: "어르신", meaning: "老人家（尊称）" }, { word: "손주", meaning: "孙子/孙女" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s5",
        ko: "이곳 노원구의 65세 이상 인구 비율은 올해 기준 18%를 넘었다.",
        zh: "芦原区65岁以上人口比例今年已超过18%。",
        pronunciation: "igot nowonguui 65se isang ingu biyureun olhae gijun 18%reul neomeotda.",
        words: [{ word: "비율", meaning: "比例" }, { word: "기준", meaning: "基准" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s6",
        ko: "전국 평균을 웃도는 숫자지만, 지방과 비교하면 이 정도면 젊은 편이다.",
        zh: "虽高过全国平均，但跟地方一比，这边还算年轻的。",
        pronunciation: "jeonguk pyeonggyuneul utdoneun sutjajiman, jibanggwa bigyohamyeon i jeongdomyeon jeolmeun pyeonida.",
        words: [{ word: "웃돌다", meaning: "超过、高于" }, { word: "지방", meaning: "地方（非首都圈）" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s7",
        ko: "전남 고흥군은 65세 이상이 43%다. 장례식장이 유일한 신축 건물이라는 말이 농담이 아닌 곳이다.",
        zh: "全南高兴郡65岁以上占43%。说殡仪馆是唯一新建建筑，在这种地方不是玩笑。",
        pronunciation: "jeonnam goheungguneun 65se isangi 43%da. jangryesikjangi yuilhan sinchuk geonmuriraneun mari nongdami anin gosida.",
        words: [{ word: "고흥군", meaning: "高兴郡（地名）" }, { word: "장례식장", meaning: "殡仪馆" }, { word: "신축", meaning: "新建" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s8",
        ko: "한국은 2017년 고령 사회, 2024년 초고령 사회로 들어섰다. 일본이 12년 걸린 변화를 7년 만에 겪은 셈이다.",
        zh: "韩国2017年进入老龄社会，2024年进入超老龄社会。日本花了12年的转变，韩国7年就经历了。",
        pronunciation: "hangugeun 2017nyeon goryeong sahoe, 2024nyeon chogoryeong sahoero deureoseotda. ilboni 12nyeon geolrin byeonhwareul 7nyeon mane gyeokkeun semida.",
        words: [{ word: "고령 사회", meaning: "老龄社会" }, { word: "초고령 사회", meaning: "超老龄社会" }, { word: "겪다", meaning: "经历" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s9",
        ko: "빨리 늙는다는 건 그만큼 준비할 시간이 없었다는 뜻이고, 실제로 허술한 구석이 한둘이 아니다.",
        zh: "老得快意味着没时间准备，事实上漏洞百出的地方不止一两处。",
        pronunciation: "ppalri neulneundaneun geon geumankeum junbihal sigani eopseotdaneun tteusigo, siljero heosulhan guseogi handuri anida.",
        words: [{ word: "허술하다", meaning: "疏漏、不严密" }, { word: "구석", meaning: "角落、方面" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s10",
        ko: "국민연금연구원 추계로는 현 체제 유지 시 기금이 2055년 바닥을 드러낸다.",
        zh: "据国民年金研究院推算，维持现行体制的话，基金2055年就会见底。",
        pronunciation: "gungminyeongeumyeonguwon chugyeroneun hyeon cheje yuji si gigeumi 2055nyeon badageul deureonaenda.",
        words: [{ word: "추계", meaning: "推算" }, { word: "바닥을 드러내다", meaning: "见底、耗尽" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s11",
        ko: "현역 세대 보험료로 은퇴 세대 연금을 메우는 구조인데, 인구 피라미드가 뒤집히면서 이 구조 자체가 위태로워졌다.",
        zh: "用现役一代保费填补退休一代养老金的结构，随着人口金字塔倒转，这个结构本身已经岌岌可危。",
        pronunciation: "hyeonyeok sedae boheomryoro euntoe sedae yeongeumeul meuneun gujoinde, ingu piramideuga dwijipimyeonseo i gujo jachega witaerowojyeotda.",
        words: [{ word: "현역", meaning: "现役（在职）" }, { word: "위태롭다", meaning: "危险、岌岌可危" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s12",
        ko: "그런데 더 큰 문제는 따로 있다. 노인 10명 중 4명이 빈곤선 아래에서 산다.",
        zh: "但更严重的问题在别处：每10名老人中就有4名生活在贫困线以下。",
        pronunciation: "geureonde deo keun munjeneun ttaro itda. noin 10myeong jung 4myeongi bingonseon araeeseo sanda.",
        words: [{ word: "빈곤선", meaning: "贫困线" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s13",
        ko: "OECD 노인 빈곤율 1위는 십수 년째 한국이다. 2위와의 차이도 꽤 크다.",
        zh: "OECD老人贫困率第一名十几年没变过，跟第二名的差距也相当大。",
        pronunciation: "OECD noin bingonyul 1wineun sipsu nyeonjjae hangugida. 2wiwaui chaido kkwae keuda.",
        words: [{ word: "빈곤율", meaning: "贫困率" }, { word: "차이", meaning: "差距" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s14",
        ko: "복지관에서 만난 김영자 씨(82)는 폐지를 주워 한 달 15만 원을 번다고 했다.",
        zh: "在福利馆遇到的82岁金英子老人说，靠捡废纸一个月挣15万韩元。",
        pronunciation: "bokjigwaneseo mannan gimyeongja ssi(82)neun pyejireul juwo han dal 15man woneul beondago haetda.",
        words: [{ word: "폐지", meaning: "废纸" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s15",
        ko: "'국민연금 28만 원에 기초연금 33만 원 타는데, 월세 25만 원 떼고 나면 밥값이 빠듯하다'고 말했다.",
        zh: "她说：\"国民年金28万加基础年金33万，扣掉月租25万，饭钱就很紧了。\"",
        pronunciation: "'gungminyeongeum 28man wone gichoyeongeum 33man won taneunde, wolse 25man won ttego namyeon bapgapsi ppadeuthada'go malhaetda.",
