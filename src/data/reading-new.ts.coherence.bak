      words: [{ word: '처음으로', meaning: '第一次' }, { word: '이어지다', meaning: '延续' }, { word: '선물', meaning: '礼物' }],
      grammarIds: [],
      difficulty: 'hard',
      note: '「-지 않고」表示「不……而……」；「처럼」表示比喻，「像……一样」。',
