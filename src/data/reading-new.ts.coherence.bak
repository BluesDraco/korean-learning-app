  coreWords: [
    { word: '배달', meaning: '配送、外卖', pronunciation: '', examples: [{ ko: "요즘 도시 어디에서나 오토바이를 타고 음식을 나르는 배달 라이더를 볼 수 있다.", zh: "最近在城市里到处都能看到骑着摩托车送餐的外卖骑手。" }, { ko: "오늘 저녁은 치킨을 배달로 시켜 먹었어요.", zh: "今晚点了外卖炸鸡吃。" }] },
    { word: '라이더', meaning: '骑手', pronunciation: '', examples: [{ ko: "배달 라이더는 정해진 회사에 속하지 않고 플랫폼을 통해 일하는 경우가 많다.", zh: "外卖骑手大多不隶属于固定的公司，而是通过平台工作。" }, { ko: "라이더가 비를 맞으며 음식을 가져다주었어요.", zh: "骑手冒着雨把食物送来了。" }] },
    { word: '플랫폼', meaning: '平台', pronunciation: '', examples: [{ ko: "이런 방식을 '플랫폼 경제'라고 부르는데, 일하는 시간을 자유롭게 정할 수 있다는 장점이 있다.", zh: "这种方式被称为“平台经济”，它有一个优点，就是可以自由决定工作时间。" }, { ko: "요즘은 여러 배달 플랫폼을 골라 쓸 수 있어요.", zh: "最近可以从多个外卖平台中挑选使用。" }] },
    { word: '수입', meaning: '收入', pronunciation: '', examples: [{ ko: "하지만 일한 만큼만 돈을 벌기 때문에 수입이 안정적이지 않다.", zh: "但因为只能挣到与工作量相应的钱，所以收入并不稳定。" }, { ko: "이번 달은 일이 많아서 수입이 늘었어요.", zh: "这个月活多，收入增加了。" }] },
    { word: '안정적', meaning: '稳定的', pronunciation: '', examples: [{ ko: "하지만 일한 만큼만 돈을 벌기 때문에 수입이 안정적이지 않다.", zh: "但因为只能挣到与工作量相应的钱，所以收入并不稳定。" }, { ko: "저는 안정적인 직장을 구하고 싶어요.", zh: "我想找一份稳定的工作。" }] },
    { word: '주문', meaning: '订单、点餐', pronunciation: '', examples: [{ ko: "주문이 몰리는 점심과 저녁 시간에는 쉬지 않고 계속 움직여야 한다.", zh: "在订单集中的午餐和晚餐时段，必须不停歇地一直忙碌。" }, { ko: "주문이 들어오면 바로 음식을 만들기 시작해요.", zh: "一有订单进来就马上开始做菜。" }] },
    { word: '배달료', meaning: '配送费', pronunciation: '', examples: [{ ko: "날씨가 나쁠수록 배달료가 올라가기 때문에 위험을 무릅쓰고 일하는 사람도 있다.", zh: "天气越差配送费越高，所以也有人冒着危险工作。" }, { ko: "거리가 멀면 배달료가 더 비싸져요.", zh: "距离远的话配送费会更贵。" }] },
    { word: '교통사고', meaning: '交通事故', pronunciation: '', examples: [{ ko: "빨리 배달하려고 서두르다가 교통사고를 당하는 라이더가 적지 않다.", zh: "为了快点送到而匆忙赶路，因此发生交通事故的骑手不在少数。" }, { ko: "빗길에서는 교통사고가 나기 쉬워요.", zh: "在雨天的路上容易发生交通事故。" }] },
    { word: '신호', meaning: '信号、红绿灯', pronunciation: '', examples: [{ ko: "그는 사고를 겪은 뒤로 아무리 급해도 신호를 지키게 되었다고 한다.", zh: "据说他经历事故之后，无论多急都开始遵守红绿灯了。" }, { ko: "신호가 빨간불이면 반드시 멈춰야 해요.", zh: "红灯亮时必须停下。" }] },
    { word: '보장', meaning: '保障', pronunciation: '', examples: [{ ko: "아프거나 다쳐도 보장을 받기 힘들어서 라이더들의 걱정이 크다.", zh: "即使生病或受伤也很难得到保障，所以骑手们的担忧很大。" }, { ko: "이 일은 사고가 나도 보장을 받기 어려워요.", zh: "这份工作即使出事也很难获得保障。" }] },
    { word: '위험', meaning: '危险', pronunciation: '', examples: [{ ko: "편리한 배달 서비스 뒤에는 위험을 안고 달리는 사람들이 있다는 것을 기억해야 한다.", zh: "我们应当记住，便利的外卖服务背后，有一群冒着危险奔跑的人。" }, { ko: "밤늦게 오토바이를 타는 것은 위험이 커요.", zh: "深夜骑摩托车危险很大。" }] },
    { word: '무릅쓰다', meaning: '冒（险）', pronunciation: '', examples: [{ ko: "날씨가 나쁠수록 배달료가 올라가기 때문에 위험을 무릅쓰고 일하는 사람도 있다.", zh: "天气越差配送费越高，所以也有人冒着危险工作。" }, { ko: "그는 위험을 무릅쓰고 물에 빠진 아이를 구했어요.", zh: "他冒着危险救了落水的孩子。" }] },
    { word: '서두르다', meaning: '匆忙、赶', pronunciation: '', examples: [{ ko: "빨리 배달하려고 서두르다가 교통사고를 당하는 라이더가 적지 않다.", zh: "为了快点送到而匆忙赶路，因此发生交通事故的骑手不在少数。" }, { ko: "약속에 늦을까 봐 아침부터 서둘렀어요.", zh: "怕约会迟到，从早上就开始赶。" }] },
    { word: '편리하다', meaning: '便利、方便', pronunciation: '', examples: [{ ko: "편리한 배달 서비스 뒤에는 위험을 안고 달리는 사람들이 있다는 것을 기억해야 한다.", zh: "我们应当记住，便利的外卖服务背后，有一群冒着危险奔跑的人。" }, { ko: "스마트폰 하나면 뭐든 주문할 수 있어서 편리해요.", zh: "只要一部手机就能点任何东西，很方便。" }] },
