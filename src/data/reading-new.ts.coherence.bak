      { word: '월세', meaning: '月租', pronunciation: '', examples: [{ ko: "전세를 구하기 어려워진 청년들은 월세로 밀려나고 있다.", zh: "难以找到全租房的青年们被迫转向月租。" }, { ko: "매달 내는 월세가 소득의 상당 부분을 차지한다.", zh: "每月支付的月租占了收入的相当一部分。" }] },
      { word: '급등', meaning: '急涨', pronunciation: '', examples: [{ ko: "집값 급등으로 인해 전세금도 크게 오르면서 부담이 더욱 커졌습니다.", zh: "由于房价急涨导致全租金也大幅上涨，负担更加沉重。" }, { ko: "부동산 가격의 급등은 사회 양극화를 심화시킨다.", zh: "房地产价格的急涨加剧了社会两极分化。" }] },
