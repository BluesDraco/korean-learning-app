      { word: '갈등', meaning: '矛盾/冲突', pronunciation: '', examples: [{ ko: "세대 간 갈등이 심화되는 배경에는 사회 전반의 양극화가 자리하고 있다.", zh: "世代间冲突加剧的背景中，存在着整个社会的两极分化。" }, { ko: "두 부서 사이의 오랜 갈등은 결국 회의를 통해 조금씩 해소되었다.", zh: "两个部门之间长期的矛盾，最终通过会议一点点得到了化解。" }] },
      { word: '산업화', meaning: '工业化', pronunciation: '', examples: [{ ko: "이른바 산업화 세대는 전쟁의 폐허 위에서 경제 성장을 이루어 낸 주역으로 평가된다.", zh: "所谓的工业化世代，被评价为在战争废墟之上实现经济增长的主角。" }, { ko: "급격한 산업화는 경제 성장과 함께 심각한 환경 오염을 불러왔다.", zh: "急剧的工业化在带来经济增长的同时，也引发了严重的环境污染。" }] },
      { word: '민주화', meaning: '民主化', pronunciation: '', examples: [{ ko: "86세대는 민주화 운동을 주도하며 절차적 정의를 중시해 왔다.", zh: "86世代主导了民主化运动，一贯重视程序正义。" }, { ko: "오랜 투쟁 끝에 그 나라는 마침내 민주화를 이루어 냈다.", zh: "经过长期斗争，那个国家终于实现了民主化。" }] },
      { word: '가치관', meaning: '价值观', pronunciation: '', examples: [{ ko: "세대 갈등은 서로 다른 역사적 경험 속에서 형성된 가치관의 충돌로 이해되어야 한다.", zh: "世代冲突应被理解为在各自不同的历史经验中形成的价值观冲突。" }, { ko: "유학 생활을 하면서 그의 가치관은 크게 바뀌었다.", zh: "在留学生活中，他的价值观发生了巨大改变。" }] },
      { word: '공정성', meaning: '公平性/公正', pronunciation: '', examples: [{ ko: "젊은 세대는 절차와 기회의 공정성에 더 민감하다.", zh: "年轻世代对程序与机会的公平更为敏感。" }, { ko: "심사 과정의 공정성을 확보하기 위해 외부 전문가가 참여했다.", zh: "为确保审查过程的公正性，外部专家参与其中。" }] },
      { word: '양극화', meaning: '两极分化', pronunciation: '', examples: [{ ko: "세대 갈등이 심화되는 배경에는 사회 전반의 양극화가 자리하고 있음이 지적된다.", zh: "有观点指出，世代间冲突加剧的背景中，存在着整个社会的两极分化。" }, { ko: "소득 양극화가 심해지면서 사회적 불만도 함께 커지고 있다.", zh: "随着收入两极分化加剧，社会不满也在一同扩大。" }] },
      { word: '기성세대', meaning: '既有世代/老一辈', pronunciation: '', examples: [{ ko: "기성세대가 결과의 평등을 강조하는 경향이 있는 반면, 젊은 세대는 기회의 공정성에 민감하다.", zh: "老一辈倾向于强调结果的平等，而年轻世代则对机会的公平更为敏感。" }, { ko: "기성세대는 종종 젊은이들의 새로운 문화를 이해하기 어려워한다.", zh: "老一辈常常难以理解年轻人的新文化。" }] },
      { word: '집단주의', meaning: '集体主义', pronunciation: '', examples: [{ ko: "언론은 세대 갈등을 흔히 집단주의와 개인주의의 대립으로 단순화한다.", zh: "媒体往往将世代冲突简化为集体主义与个人主义的对立。" }, { ko: "전통적으로 동아시아 사회는 개인보다 조직을 앞세우는 집단주의 성향이 강하다.", zh: "传统上，东亚社会具有把组织置于个人之前的强烈集体主义倾向。" }] },
      { word: '개인주의', meaning: '个人主义', pronunciation: '', examples: [{ ko: "언론은 세대 갈등을 집단주의와 개인주의의 대립으로 단순화하는 경향을 보인다.", zh: "媒体倾向于将世代冲突简化为集体主义与个人主义的对立。" }, { ko: "젊은 세대 사이에서는 자신의 삶을 중시하는 개인주의 성향이 뚜렷해지고 있다.", zh: "在年轻世代之间，重视自身生活的个人主义倾向愈发明显。" }] },
      { word: '고용', meaning: '雇佣/就业', pronunciation: '', examples: [{ ko: "MZ세대는 저성장과 고용 불안이 일상화된 환경 속에서 성장하였다.", zh: "MZ世代成长于低增长与就业不安已然日常化的环境之中。" }, { ko: "경기 침체가 길어지면서 청년층의 고용 상황은 더욱 나빠졌다.", zh: "随着经济衰退拖长，青年阶层的就业状况进一步恶化。" }] },
      { word: '부동산', meaning: '不动产/房产', pronunciation: '', examples: [{ ko: "부동산 가격의 급등으로 인해 청년층이 자산을 축적할 기회는 크게 축소되었다.", zh: "由于房价暴涨，青年阶层积累资产的机会大幅缩减。" }, { ko: "정부의 규제에도 불구하고 대도시의 부동산 가격은 좀처럼 안정되지 않았다.", zh: "尽管有政府的管制，大城市的房价却始终难以稳定。" }] },
      { word: '소통', meaning: '沟通', pronunciation: '', examples: [{ ko: "세대 갈등의 해소는 구조적 원인에 대한 진지한 소통에서 출발해야 한다.", zh: "世代冲突的化解应从对结构性原因的认真沟通出发。" }, { ko: "세대 간의 벽을 허물기 위해서는 무엇보다 열린 소통이 필요하다.", zh: "要打破世代之间的隔阂，最需要的是开放的沟通。" }] },
