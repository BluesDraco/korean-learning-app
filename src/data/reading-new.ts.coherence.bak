      { word: '소멸', meaning: '消亡/消失', pronunciation: '', examples: [{ ko: "인구가 지속적으로 감소하면 일정 지역이 소멸 위기에 처하게 된다.", zh: "人口若持续减少，特定地区便会陷入消亡危机。" }, { ko: "전문가들은 향후 30년 안에 상당수의 농촌 마을이 소멸할 것으로 전망한다.", zh: "专家们预测，今后30年内相当数量的农村村落将会消亡。" }] },
      { word: '수도권', meaning: '首都圈', pronunciation: '', examples: [{ ko: "통계에 따르면 전체 인구의 절반 이상이 수도권에 거주하는 것으로 나타났다.", zh: "据统计，全国半数以上的人口居住在首都圈。" }, { ko: "일자리와 교육 기회가 수도권에 몰리면서 지역 간 격차가 갈수록 벌어지고 있다.", zh: "随着工作岗位与教育机会集中于首都圈，地区间的差距日益扩大。" }] },
      { word: '집중', meaning: '集中', pronunciation: '', examples: [{ ko: "이러한 현상은 무엇보다 인구의 수도권 집중으로 인해 가속화되고 있다.", zh: "这一现象首先因人口向首都圈集中而加速。" }, { ko: "자원과 권한이 특정 지역에 지나치게 집중되면 국가의 균형 발전은 어려워진다.", zh: "资源与权限一旦过度集中于特定地区，国家的均衡发展便会变得困难。" }] },
      { word: '공동화', meaning: '空心化', pronunciation: '', examples: [{ ko: "지방의 여러 도시와 농촌은 이른바 ‘공동화’ 현상을 겪고 있다.", zh: "地方的许多城市与农村正经历所谓的“空心化”现象。" }, { ko: "젊은 인구가 빠져나간 원도심은 상권마저 무너지며 급격한 공동화에 시달리고 있다.", zh: "年轻人口流失后的老城区连商圈也随之崩塌，正饱受急剧空心化之苦。" }] },
      { word: '저출생', meaning: '低出生率', pronunciation: '', examples: [{ ko: "저출생과 고령화가 동시에 진행됨으로써 지방의 인구 구조는 더욱 취약해지고 있다.", zh: "随着低出生率与老龄化同时推进，地方的人口结构变得愈发脆弱。" }, { ko: "정부는 저출생 문제를 해결하기 위해 막대한 예산을 투입했으나 뚜렷한 성과를 거두지 못했다.", zh: "政府为解决低出生率问题投入了巨额预算，却未能取得明显成效。" }] },
      { word: '고령화', meaning: '老龄化', pronunciation: '', examples: [{ ko: "저출생과 고령화가 동시에 진행되면서 지방의 인구 구조는 급속히 무너지고 있다.", zh: "随着低出生率与老龄化同时推进，地方的人口结构正在迅速崩解。" }, { ko: "고령화가 심화될수록 생산 가능 인구가 줄어 사회 전체의 부담이 커진다.", zh: "老龄化越是加剧，可劳动人口就越减少，整个社会的负担随之加重。" }] },
      { word: '유출', meaning: '外流/流失', pronunciation: '', examples: [{ ko: "청년층이 교육과 일자리를 찾아 대도시로 이동하면서 지방의 인구 유출이 심화되었다.", zh: "青年阶层为寻找教育与工作机会迁往大城市，使地方的人口流失日益加剧。" }, { ko: "우수한 인재의 지속적인 유출은 지역 경제의 활력을 근본적으로 떨어뜨린다.", zh: "优秀人才的持续外流从根本上削弱了地区经济的活力。" }] },
      { word: '균형', meaning: '均衡/平衡', pronunciation: '', examples: [{ ko: "지방 소멸이 현실화될 경우 국가 전체의 균형 발전이 크게 위협받을 것으로 우려된다.", zh: "若地方消亡成为现实，人们担忧整个国家的均衡发展将受到严重威胁。" }, { ko: "수도권과 지방 사이의 균형을 회복하지 않는 한 지속 가능한 성장은 기대하기 어렵다.", zh: "除非恢复首都圈与地方之间的均衡，否则难以期待可持续的增长。" }] },
      { word: '유치', meaning: '吸引/招揽', pronunciation: '', examples: [{ ko: "대표적으로 청년을 유치하기 위한 주거 지원과 창업 지원 정책이 시행되고 있다.", zh: "具有代表性的是，为吸引青年而实施的住房支持与创业支持政策。" }, { ko: "지방자치단체들은 대기업 공장을 유치하고자 각종 세제 혜택을 앞다투어 내놓고 있다.", zh: "各地方自治团体为招揽大企业工厂，争相推出各种税收优惠。" }] },
      { word: '정착', meaning: '定居', pronunciation: '', examples: [{ ko: "양질의 일자리와 문화 기반이 갖추어지지 않는 한 청년의 지방 정착은 지속되기 어렵다.", zh: "除非具备优质的工作岗位与文化基础，否则青年的地方定居难以持续。" }, { ko: "귀농을 결심한 부부는 오랜 준비 끝에 마침내 그 마을에 정착하기로 했다.", zh: "决心返乡务农的这对夫妇，在长久准备之后终于决定在那个村庄定居。" }] },
      { word: '인프라', meaning: '基础设施', pronunciation: '', examples: [{ ko: "학교와 병원 등 필수 인프라가 잇따라 문을 닫는 사례가 늘고 있다.", zh: "学校、医院等必要基础设施接连关闭的案例正在增加。" }, { ko: "교통과 의료 인프라가 부실한 지역일수록 인구 유출이 더욱 빠르게 진행된다.", zh: "交通与医疗基础设施越薄弱的地区，人口外流进行得越快。" }] },
      { word: '지자체', meaning: '地方自治体', pronunciation: '', examples: [{ ko: "이에 따라 중앙정부와 지자체는 다양한 대책을 마련하고 있다.", zh: "据此，中央政府与地方自治体正在制定各种对策。" }, { ko: "재정이 열악한 지자체일수록 중앙정부의 지원에 크게 의존할 수밖에 없다.", zh: "财政越困难的地方自治体，越是不得不高度依赖中央政府的支援。" }] },
      { word: '재정', meaning: '财政', pronunciation: '', examples: [{ ko: "그러나 단순한 재정 지원만으로는 근본적인 해결이 어렵다는 지적도 제기된다.", zh: "然而，也有人指出，仅靠单纯的财政支持难以从根本上解决问题。" }, { ko: "인구가 감소하면 세수가 줄어 지방정부의 재정은 갈수록 악화된다.", zh: "人口一旦减少，税收随之减少，地方政府的财政日益恶化。" }] },
