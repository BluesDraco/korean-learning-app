    coreWords: [
      { word: '언어 변화', meaning: '语言变化', pronunciation: '', examples: [{ ko: "이러한 언어 변화는 언어 공동체 내의 연대감 형성과 정체성 표현의 수단으로 기능한다.", zh: "这种语言变化在语言共同体内部起到形成团结感和表达身份认同的手段的功能。" }, { ko: "언어 변화는 억압한다고 멈출 수 있는 것이 아니라 사회의 흐름을 반영하는 자연스러운 현상이다.", zh: "语言变化并非靠压制就能停止，而是反映社会流变的自然现象。" }] },
      { word: '신조어', meaning: '新造词', pronunciation: '', examples: [{ ko: "온라인 커뮤니티에서 발생한 신조어는 실시간으로 젊은 세대의 언어 생활 속으로 침투하고 있다.", zh: "在网络社区中产生的新造词，正在实时渗透进年轻世代的语言生活中。" }, { ko: "신조어의 대다수는 유행이 지나면 사라지지만, 일부는 사전에 등재될 만큼 정착한다.", zh: "多数新造词随着流行退去而消失，但也有一些会稳定到被收录进词典的程度。" }] },
      { word: '축약어', meaning: '缩略词', pronunciation: '', examples: [{ ko: "온라인에서 생겨난 축약어들은 입력의 효율을 높이려는 욕구에서 비롯된다.", zh: "在网络上诞生的缩略词，源于提高输入效率的欲求。" }, { ko: "\"갑분싸\"와 같은 축약어는 긴 표현을 압축함으로써 세대 언어의 창의성을 드러낸다.", zh: "\"갑분싸\"这样的缩略词通过压缩冗长的表达，展现出世代语言的创造性。" }] },
      { word: '외래어', meaning: '外来词', pronunciation: '', examples: [{ ko: "영어를 위시한 외래어의 대량 유입은 한국어 어휘 체계를 급속히 재편하고 있다.", zh: "以英语为首的外来词大量涌入，正在迅速重构韩语词汇体系。" }, { ko: "외래어를 무분별하게 남용하면 세대 간 소통에 장벽이 생길 수 있다.", zh: "若毫无节制地滥用外来词，可能会在代际交流中筑起壁垒。" }] },
      { word: '표준어', meaning: '标准语', pronunciation: '', examples: [{ ko: "방언의 보존은 주목받고 있으나, 표준어 교육과의 균형 문제가 과제로 남는다.", zh: "方言的保存受到关注，但与标准语教育的平衡问题作为课题留存。" }, { ko: "표준어는 공적 소통의 기준을 제공하지만, 그 자체가 절대적 우월성을 뜻하지는 않는다.", zh: "标准语提供了公共交流的基准，但这本身并不意味着绝对的优越性。" }] },
      { word: '방언', meaning: '方言', pronunciation: '', examples: [{ ko: "방언의 보존 역시 언어적 다양성 차원에서 주목받고 있다.", zh: "方言的保存在语言多样性层面也受到关注。" }, { ko: "각 지역의 방언은 그 공동체의 정서와 역사를 담은 소중한 문화 자산이다.", zh: "各地区的方言是承载着该共同体情感与历史的宝贵文化资产。" }] },
      { word: '언어 순화', meaning: '语言净化', pronunciation: '', examples: [{ ko: "국립국어원은 언어 순화와 표준화를 통해 한국어의 규범적 기반을 유지하려 노력하고 있다.", zh: "国立国语院正在努力通过语言净化和标准化来维持韩语的规范性基础。" }, { ko: "언어 순화 정책이 실생활의 언어 사용을 얼마나 바꿀 수 있는지에 대해서는 논란이 있다.", zh: "语言净化政策究竟能在多大程度上改变现实生活中的语言使用，对此存在争议。" }] },
      { word: '세대 격차', meaning: '代际差异', pronunciation: '', examples: [{ ko: "세대 간 어휘 격차가 심화될수록 원활한 소통이 저해될 수 있다는 점이 지적된다.", zh: "世代间词汇差距越加深，顺畅的交流越可能受到阻碍，这一点受到指出。" }, { ko: "언어의 세대 격차는 단순한 유행어의 문제가 아니라 사고방식의 차이를 반영한다.", zh: "语言的代际差异并非单纯的流行语问题，而是反映了思维方式的差别。" }] },
      { word: '디지털 소통', meaning: '数字交流', pronunciation: '', examples: [{ ko: "디지털 소통 환경은 문자와 이모티콘을 결합한 새로운 표현 방식을 낳았다.", zh: "数字交流环境催生了结合文字与表情符号的新型表达方式。" }, { ko: "실시간성이 강조되는 디지털 소통에서는 표현의 간결함과 속도가 무엇보다 중시된다.", zh: "在强调实时性的数字交流中，表达的简洁与速度被看得比什么都重要。" }] },
      { word: '언어 공동체', meaning: '语言共同体', pronunciation: '', examples: [{ ko: "규범주의자들은 신조어의 범람이 언어 공동체의 소통 기반을 잠식한다고 우려한다.", zh: "规范主义者担忧，新造词的泛滥会侵蚀语言共同体的交流基础。" }, { ko: "하나의 언어 공동체는 공통된 어휘와 문법을 매개로 소속감을 공유한다.", zh: "一个语言共同体以共同的词汇和语法为媒介，共享归属感。" }] },
      { word: '어휘', meaning: '词汇', pronunciation: '', examples: [{ ko: "외래어의 유입은 한국어 어휘 체계를 급속히 재편하고 있다.", zh: "外来词的涌入正在迅速重构韩语词汇体系。" }, { ko: "풍부한 어휘를 구사할수록 미묘한 감정과 사고를 정교하게 표현할 수 있다.", zh: "越能自如驾驭丰富的词汇，就越能精细地表达微妙的情感与思考。" }] },
      { word: '맥락', meaning: '脉络/语境', pronunciation: '', examples: [{ ko: "사회언어학자들은 변화의 맥락을 이해하고 사회적으로 관리하는 것이 중요하다고 강조한다.", zh: "社会语言学家们强调，理解变化的语境并进行社会性管理十分重要。" }, { ko: "같은 표현이라도 맥락에 따라 전혀 다른 의미로 해석될 수 있다.", zh: "即便是相同的表达，也可能因语境不同而被解读为完全不同的意思。" }] },
      { word: '규범', meaning: '规范', pronunciation: '', examples: [{ ko: "한국어의 변화는 규범과 창의성 사이의 긴장을 생산적으로 관리할 때 언어를 더욱 풍부하게 한다.", zh: "韩语的变化，在生产性地管理规范与创造性之间的张力时，会使语言更加丰富。" }, { ko: "언어 규범은 소통의 안정성을 보장하지만, 지나치게 경직되면 언어의 활력을 억누른다.", zh: "语言规范保障了交流的稳定性，但若过于僵化，就会压抑语言的活力。" }] },
      { word: '창의성', meaning: '创造性', pronunciation: '', examples: [{ ko: "\"갑분싸\", \"킹받다\" 등은 세대 언어의 창의성을 보여주는 대표적 사례다.", zh: "\"갑분싸\"、\"킹받다\"等是展示世代语言创造性的典型案例。" }, { ko: "신조어의 생성은 언어 사용자들의 놀라운 창의성이 발현되는 장이다.", zh: "新造词的生成，是语言使用者惊人创造性得以彰显的场域。" }] },
    ],
    grammarIds: ['g35', 'g78', 'g49', 'g67', 'g83'],
    grammarCardIds: ['card-p13-l05', 'card-p28-l04', 'card-p23-l01', 'card-p10-l06'],
    sentences: [
      {
        id: "s1",
        ko: "한글 창제는 언어가 민중의 삶을 담는 그릇이라는 명제를 역사적으로 실증한 사건이다.",
        zh: "训民正音的创制，是历史上印证了\"语言是盛载民众生活之器\"这一命题的事件。",
        pronunciation: "한글 창제는 언어가 민중의 삶을 담는 그릇이라는 명제를 역사적으로 실증한 사건이다.",
        words: [{ word: "창제", meaning: "创制" }, { word: "민중", meaning: "民众" }, { word: "명제", meaning: "命题" }, { word: "실증하다", meaning: "实证，用事实证明" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s2",
        ko: "세종대왕이 창안한 표음 문자 체계는 언어 공동체의 형성을 전제로 하는 기획이었다.",
        zh: "世宗大王创制的表音文字体系，是以语言共同体的形成为前提的宏大规划。",
        pronunciation: "세종대왕이 창안한 표음 문자 체계는 언어 공동체의 형성을 전제로 하는 기획이었다.",
        words: [{ word: "표음 문자", meaning: "表音文字" }, { word: "창안하다", meaning: "创制，创造" }, { word: "기획", meaning: "规划，企划" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s3",
        ko: "조선 시대 한자 중심의 문어 전통은 언어 변화의 방향을 수백 년간 억압하는 기제로 작동했다.",
        zh: "朝鲜时代以汉字为中心的书面语传统，作为压制语言变化方向数百年的机制而运作。",
        pronunciation: "조선 시대 한자 중심의 문어 전통은 언어 변화의 방향을 수백 년간 억압하는 기제로 작동했다.",
        words: [{ word: "문어", meaning: "书面语" }, { word: "기제", meaning: "机制" }, { word: "억압하다", meaning: "压制，压抑" }],
