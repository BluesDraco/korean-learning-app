      '了解韩国升学竞争与补习文化',
    ],
    coreWords: [
      { word: '입시', meaning: '升学考试', pronunciation: '', examples: [{ ko: "이로 인해 어린 시절부터 입시를 위한 경쟁이 시작됩니다.", zh: "因此，从小时候起就开始了为升学而进行的竞争。" }, { ko: "입시를 앞둔 수험생들은 극심한 압박감에 시달린다.", zh: "面临升学考试的考生们饱受巨大压力的折磨。" }] },
      { word: '경쟁', meaning: '竞争', pronunciation: '', examples: [{ ko: "일부 전문가들은 이러한 경쟁 문화가 창의성을 억제한다고 주장합니다.", zh: "部分专家主张，这种竞争文化会抑制创造力。" }, { ko: "치열한 경쟁 속에서 살아남으려면 끊임없는 노력이 필요하다.", zh: "要在激烈的竞争中生存下来，需要不懈的努力。" }] },
      { word: '사교육', meaning: '课外补习', pronunciation: '', examples: [{ ko: "한국의 사교육 시장 규모는 매년 증가하는 추세를 보입니다.", zh: "韩国课外教育市场规模呈现每年增长的趋势。" }, { ko: "사교육에 의존하지 않고도 공교육만으로 충분한 학습이 가능해야 한다.", zh: "即使不依赖课外补习，仅靠公立教育也应能实现充分的学习。" }] },
      { word: '학원', meaning: '补习班', pronunciation: '', examples: [{ ko: "많은 학생들이 학교 수업이 끝난 후에도 학원에 다닙니다.", zh: "很多学生放学后还要去补习班。" }, { ko: "아이들은 방과 후 여러 학원을 전전하며 하루를 보낸다.", zh: "孩子们放学后辗转于多个补习班度过一天。" }] },
      { word: '수능', meaning: '修学能力考试', pronunciation: '', examples: [{ ko: "수능 성적으로 인한 스트레스는 학생들에게 큰 부담이 됩니다.", zh: "由修能成绩引发的压力对学生来说是很大的负担。" }, { ko: "수능은 한국 학생들의 인생을 좌우하는 중요한 시험으로 여겨진다.", zh: "修能被视为左右韩国学生人生的重要考试。" }] },
      { word: '명문대', meaning: '名牌大学', pronunciation: '', examples: [{ ko: "명문대 진학은 좋은 취업으로 이어진다는 인식이 강합니다.", zh: "进入名牌大学能带来好就业机会的观念根深蒂固。" }, { ko: "명문대 졸업장이 성공을 보장하던 시대는 저물어 가고 있다.", zh: "名牌大学文凭保障成功的时代正在落幕。" }] },
      { word: '과열', meaning: '过热', pronunciation: '', examples: [{ ko: "사교육비 지출이 과열됨에도 불구하고 학부모들은 포기하지 못합니다.", zh: "尽管课外教育支出已经过热，家长们却无法放弃。" }, { ko: "입시 경쟁의 과열은 학생들의 정서에 부정적인 영향을 미친다.", zh: "升学竞争的过热对学生的情绪产生负面影响。" }] },
      { word: '부담', meaning: '负担', pronunciation: '', examples: [{ ko: "수능 성적으로 인한 스트레스는 학생들에게 큰 부담이 됩니다.", zh: "由修能成绩引发的压力对学生来说是很大的负担。" }, { ko: "과도한 학업 부담은 청소년의 정신 건강을 위협한다.", zh: "过度的学业负担威胁着青少年的心理健康。" }] },
      { word: '성적', meaning: '成绩', pronunciation: '', examples: [{ ko: "수능 성적으로 인한 스트레스는 학생들에게 큰 부담이 됩니다.", zh: "由修能成绩引发的压力对学生来说是很大的负担。" }, { ko: "성적만으로 학생의 가치를 판단해서는 안 된다.", zh: "不应仅凭成绩来判断学生的价值。" }] },
      { word: '진로', meaning: '发展方向', pronunciation: '', examples: [{ ko: "학생들이 자신의 적성에 맞는 진로를 찾도록 돕는 것이 중요하다.", zh: "帮助学生找到适合自己天赋的发展方向很重要。" }, { ko: "진로를 결정하기 전에 다양한 경험을 쌓을 필요가 있다.", zh: "在决定发展方向之前，有必要积累多样的经验。" }] },
      { word: '취업', meaning: '就业', pronunciation: '', examples: [{ ko: "명문대 진학은 좋은 취업으로 이어진다는 인식이 강합니다.", zh: "进入名牌大学能带来好就业机会的观念根深蒂固。" }, { ko: "청년 취업난이 심각해지면서 사회적 불안이 커지고 있다.", zh: "随着青年就业困难加剧，社会不安正在扩大。" }] },
      { word: '학벌', meaning: '学历背景', pronunciation: '', examples: [{ ko: "학벌 중심의 사회 구조가 바뀌지 않는 한 근본적인 해결은 어렵습니다.", zh: "只要以学历为中心的社会结构不改变，根本性的解决就很困难。" }, { ko: "능력보다 학벌을 우선시하는 채용 관행은 개선되어야 한다.", zh: "比起能力更优先考虑学历背景的招聘惯例应当改善。" }] },
