    coreWords: [
      { word: '재외 동포', meaning: '海外同胞', pronunciation: '', examples: [{ ko: "재외 동포들은 흔히 \"어디에도 완전히 속하지 않는\" 주변성을 경험하며, 이를 통해 독특한 문화적 혼종성을 발전시킨다.", zh: "海外同胞们常常经历\"哪里都不完全属于\"的边缘性，并通过这一过程发展出独特的文化混杂性。" }, { ko: "정부는 재외 동포를 대상으로 모국어 교육과 문화 체험 프로그램을 확대하고 있다.", zh: "政府正面向海外同胞，扩大母语教育与文化体验项目。" }] },
      { word: '정체성', meaning: '身份认同/认同感', pronunciation: '', examples: [{ ko: "정체성의 문제는 단순히 개인적 차원에 머무르지 않고, 사회적·정치적 맥락과 깊이 연루되어 있다.", zh: "身份认同的问题不仅停留于个人层面，而且与社会性、政治性脉络深度交织。" }, { ko: "이민 2세대는 두 문화 사이에서 자신의 정체성을 끊임없이 재정립해 나간다.", zh: "移民二代在两种文化之间，不断重新确立自己的身份认同。" }] },
      { word: '디아스포라', meaning: '离散族群/流散', pronunciation: '', examples: [{ ko: "전 세계에 약 750만 명에 달하는 재외 한인은 한국 디아스포라의 다양한 면모를 보여준다.", zh: "遍布全世界约750万名海外韩人，展现了韩国离散族群的多元面貌。" }, { ko: "디아스포라 연구는 이주와 정착, 그리고 정체성의 문제를 폭넓게 다룬다.", zh: "离散族群研究广泛探讨迁移与定居，以及身份认同的问题。" }] },
      { word: '동화', meaning: '同化/融入', pronunciation: '', examples: [{ ko: "이들은 거주국의 사회에 동화되는 동시에 모국의 문화적 유산을 보존하려는 이중적 과제를 안고 있다.", zh: "他们同时肩负着融入居住国社会以及保存母国文化遗产的双重课题。" }, { ko: "지나친 동화는 고유의 문화적 뿌리를 상실하는 결과를 낳기도 한다.", zh: "过度的同化，有时也会导致丧失固有文化根基的结果。" }] },
      { word: '이중 정체성', meaning: '双重身份认同', pronunciation: '', examples: [{ ko: "재외 동포들은 거주국 문화와 모국의 전통 사이에서 이중 정체성을 형성하는 경우가 많다.", zh: "海外同胞往往在居住国文化与母国传统之间，形成双重身份认同。" }, { ko: "이중 정체성은 갈등의 원인이 아니라 오히려 풍부한 문화적 자산이 될 수 있다.", zh: "双重身份认同并非冲突的根源，反而可以成为丰富的文化资产。" }] },
      { word: '귀속감', meaning: '归属感', pronunciation: '', examples: [{ ko: "재일 동포들은 식민지 역사의 유산으로 인해 법적 지위와 문화적 귀속감 사이의 괴리를 경험해 왔다.", zh: "在日同胞因殖民地历史的遗产，长期经历着法律地位与文化归属感之间的落差。" }, { ko: "공동체에 대한 귀속감은 개인의 심리적 안정에 결정적인 영향을 미친다.", zh: "对共同体的归属感，对个人的心理稳定起着决定性影响。" }] },
      { word: '모국', meaning: '母国/祖国', pronunciation: '', examples: [{ ko: "한류의 세계적 확산은 재외 동포들에게 모국에 대한 자긍심을 높이는 동시에 한인 정체성을 재발견하는 계기가 되고 있다.", zh: "韩流的全球扩散，在提升海外同胞对母国自豪感的同时，也成为重新发现韩人身份认同的契机。" }, { ko: "오랜 이민 생활에도 그는 모국의 언어와 관습을 결코 잊지 않았다.", zh: "尽管移民生活漫长，他也从未忘记母国的语言与习俗。" }] },
      { word: '이민', meaning: '移民', pronunciation: '', examples: [{ ko: "1세대 이민자들은 한국 국적과 문화적 정체성을 강하게 유지하는 경향이 있는 반면, 2세대 이후는 거주국 사회에 보다 깊이 통합된다.", zh: "第一代移民倾向于强烈维持韩国国籍和文化认同，而第二代以后则更深度融入居住国社会。" }, { ko: "더 나은 삶을 찾아 낯선 나라로 떠나는 이민은 언제나 큰 결단을 요구한다.", zh: "为寻求更好的生活而奔赴陌生国度的移民，总是需要巨大的决断。" }] },
      { word: '문화적 혼종성', meaning: '文化混杂性', pronunciation: '', examples: [{ ko: "재외 동포들은 주변성을 경험하며, 이를 통해 독특한 문화적 혼종성을 발전시킨다.", zh: "海外同胞们经历着边缘性，并通过这一过程发展出独特的文化混杂性。" }, { ko: "이민 사회의 음식 문화는 서로 다른 전통이 뒤섞인 문화적 혼종성을 잘 보여준다.", zh: "移民社会的饮食文化，很好地展现了不同传统交融的文化混杂性。" }] },
      { word: '세대', meaning: '世代', pronunciation: '', examples: [{ ko: "이민 1세대와 2세대는 언어와 정체성 인식에서 뚜렷한 세대 차이를 보인다.", zh: "移民一代与二代，在语言和身份认同意识上呈现出明显的世代差异。" }, { ko: "디지털 환경에서 자란 젊은 세대는 소통 방식 자체가 이전과 다르다.", zh: "在数字环境中成长的年轻世代，其沟通方式本身就与从前不同。" }] },
      { word: '언어 상실', meaning: '语言丧失', pronunciation: '', examples: [{ ko: "이 과정에서 언어 상실이 가속화되는 바, 한국어 교육은 정체성 보존의 핵심 수단으로 부각된다.", zh: "在这一过程中，语言丧失加速，因此韩语教育作为保存身份认同的核心手段而凸显。" }, { ko: "세대가 거듭될수록 모국어의 언어 상실은 피하기 어려운 현상이 된다.", zh: "随着世代更迭，母语的语言丧失成为难以避免的现象。" }] },
      { word: '초국가적', meaning: '跨国的/超国家的', pronunciation: '', examples: [{ ko: "디지털 기술의 발달로 초국가적 네트워크가 강화됨에 따라, 재외 동포들의 모국과의 유대가 새로운 방식으로 유지되고 있다.", zh: "随着数字技术发展超国家网络得到强化，海外同胞与母国的纽带正以新方式得以维系。" }, { ko: "기후 위기는 한 나라의 힘만으로는 해결할 수 없는 초국가적 과제다.", zh: "气候危机是仅凭一国之力无法解决的跨国性课题。" }] },
      { word: '소속', meaning: '归属/所属', pronunciation: '', examples: [{ ko: "재외 한인의 삶은 단순한 이주의 서사를 넘어, 인간 존재와 소속의 본질에 대한 깊은 성찰을 요구한다.", zh: "海外韩人的生活超越了简单的移民叙事，要求对人类存在与归属的本质进行深刻反思。" }, { ko: "인간은 누구나 어딘가에 소속되고자 하는 근원적 욕구를 지닌다.", zh: "人人都怀有想要归属于某处的根本性欲求。" }] },
      { word: '유대', meaning: '纽带/联系', pronunciation: '', examples: [{ ko: "재외 동포들의 모국과의 유대가 새로운 방식으로 유지되고 있다.", zh: "海外同胞与母国的纽带正以新方式得以维系。" }, { ko: "함께 겪은 고난은 구성원들 사이에 끈끈한 유대를 형성한다.", zh: "共同经历的苦难，会在成员之间形成牢固的纽带。" }] },
    ],
    grammarIds: ['g82', 'g83', 'g67', 'g13', 'g20'],
    grammarCardIds: ['card-p13-l05', 'card-p23-l01', 'card-p18-l03', 'card-p13-l01'],
    sentences: [
      {
        id: "s1",
        ko: "LA 코리아타운 올림픽 대로에서 한 블록 떨어진 낡은 아파트, 여든두 살 김옥순 씨는 매주 일요일 새벽 다섯 시면 어김없이 주방 불을 켠다.",
        zh: "洛杉矶韩国城，距奥林匹克大道一个街区之遥的老旧公寓里，82岁的金玉顺每周日清晨五点，雷打不动地亮起厨房的灯。",
        pronunciation: "LA koriataun olrimpik daeroeseo han beulrok tteoreojin nalgeun apateu, yeodeundu sal gimoksun ssineun maeju iryoil saebyeok daseot simyeon eogimeopsi jubang bureul kyeonda.",
        words: [{ word: "어김없이", meaning: "毫无例外地" }, { word: "낡은", meaning: "老旧的" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s2",
        ko: "당근을 채 치고 달걀 지단을 부치는 손끝은 오십 년 전 부산 수정동 골목에서 어머니한테 배운 그대로 멈춰 있다.",
        zh: "切胡萝卜丝、摊鸡蛋薄饼的指尖动作，与五十年前在釜山水晶洞巷子里从母亲那里学来的一模一样。",
        pronunciation: "danggeuneul chae chigo dalgyal jidaneul buchineun sonkkeuteun osip nyeon jeon busan sujeongdong golmogeseo eomeonihante baeun geudaero meomchwo itda.",
        words: [{ word: "채 치다", meaning: "切丝" }, { word: "지단", meaning: "薄蛋饼" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s3",
        ko: "김발 위에 김을 펴고 밥을 고르게 편다. 열여섯 살 상경하던 날 어머니가 쥐여준 보자기 속 김밥의 감촉이 육십육 년을 건너 지금 이 손끝에 살아 있다.",
        zh: "在海苔卷帘上铺开紫菜、匀匀地摊上米饭——十六岁离家上京那天，母亲塞进她包袱里的那卷紫菜包饭的触感，穿越六十六年光阴，此刻依然活在这指尖上。",
        pronunciation: "gimbal wie gimeul pyeogo babeul goreuge pyeonda. yeoryeoseot sal sanggyeonghadeon nal eomeoniga jwiyeojun bojagi sok gimbabui gamchogi yuksibyuk nyeoneul geonneo jigeum i sonkkeute sara itda.",
        words: [{ word: "김발", meaning: "紫菜卷帘" }, { word: "감촉", meaning: "触感" }, { word: "보자기", meaning: "包袱布" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s4",
        ko: "현관문이 열리고 스무 살 손자 제이슨이 운동화를 벗으며 '그랜마!' 하고 외친다.",
        zh: "玄关门开了，二十岁的孙子杰森一边脱运动鞋，一边喊了一声'Grandma！'。",
        pronunciation: "hyeongwanmuni yeolrigo seumu sal sonja jeiseuni undonghwareul beoseumyeo 'geuraenma!' hago oechinda.",
        words: [{ word: "현관문", meaning: "玄关门" }, { word: "외치다", meaning: "喊叫" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s5",
        ko: "김 씨가 한국말로 '밥 먹었니' 하고 묻자 제이슨은 잠시 멈칫하다 '예스' 하고 답한다.",
        zh: "金女士用韩语问'吃饭了吗'，杰森迟疑片刻，回了一声'Yes'。",
        pronunciation: "gim ssiga hangungmalro 'bap meogeotni' hago mutja jeiseuneun jamsi meomchithada 'yeseu' hago dapanda.",
        words: [{ word: "멈칫하다", meaning: "迟疑" }, { word: "묻다", meaning: "询问" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s6",
        ko: "둘 사이에 놓인 언어의 간극은 냉장고 문이 닫히는 소리보다 더 크게 방 안을 채운다.",
        zh: "横亘在两人之间的语言鸿沟，比冰箱门关上的声响更沉重地填满整个房间。",
        pronunciation: "dul saie nohin eoneoui gangeugeun naengjanggo muni dachineun soriboda deo keuge bang aneul chaeunda.",
        words: [{ word: "간극", meaning: "鸿沟" }, { word: "채우다", meaning: "填满" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s7",
        ko: "제이슨이 이해하는 한국어 단어는 열 개 남짓이고, '할머니'도 '사랑해'도 아닌 음식 이름들—불고기, 김치, 갈비, 만두—이 그 전부를 차지한다.",
        zh: "杰森能听懂的韩语单词不过十个，其中既非'奶奶'也非'我爱你'，而是食物名称——烤牛肉、泡菜、排骨、饺子——占据了全部。",
        pronunciation: "jeiseuni ihaehaneun hangugeo daneoneun yeol gae namjisigo, 'halmeoni'do 'saranghae'do anin eumsik ireumdeul—bulgogi, gimchi, galbi, mandu—i geu jeonbureul chajihanda.",
        words: [{ word: "남짓", meaning: "大约" }, { word: "전부", meaning: "全部" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s8",
        ko: "김 씨가 남편을 따라 로스앤젤레스에 첫발을 디딘 것은 1973년이다. 두 손에 생후 여덟 달 큰아들, 등에 시어머니가 짜준 면 보자기 하나를 짊어진 채로.",
        zh: "金女士跟随丈夫踏上洛杉矶的土地，是1973年——双手抱着八个月大的大儿子，背上驮着婆婆织的一只棉布包袱。",
        pronunciation: "gim ssiga nampyeoneul ttara roseuaenjelreseue cheotbareul didin geoseun 1973nyeonida. du sone saenghu yeodeol dal keunadeul, deunge sieomeoniga jjajun myeon bojagi hanareul jilmeojin chaero.",
        words: [{ word: "첫발을 디디다", meaning: "踏上第一步" }, { word: "짊어지다", meaning: "背负" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s9",
        ko: "스무 살에 닿은 미국, 마흔에 연 세탁소, 쉰에 손에 쥔 시민권. 김 씨의 인생은 숫자가 아니라 표백제와 식용유와 교회 스티로폼 커피컵의 냄새로 편집된다.",
        zh: "二十岁抵达的美国，四十岁开的洗衣店，五十岁握在手中的公民证——金女士的人生不是用数字，而是用漂白剂、食用油和教会泡沫塑料咖啡杯的气味编纂而成。",
        pronunciation: "seumu sare daheun miguk, maheune yeon setakso, swine sone jwin simingwon. gim ssiui insaengeun sutjaga anira pyobaekjewa sigyongyuwa gyohoe seutiropom keopikeobui naemsaero pyeonjipdoenda.",
        words: [{ word: "표백제", meaning: "漂白剂" }, { word: "편집되다", meaning: "被编纂" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
