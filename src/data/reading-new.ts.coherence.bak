    ],
    coreWords: [
      { word: '민주화', meaning: '民主化', pronunciation: '', examples: [{ ko: "한국의 민주화 운동은 수십 년에 걸친 시민들의 투쟁에 의해 이루어졌습니다.", zh: "韩国的民主化运动是由数十年来市民们的斗争所实现的。" }, { ko: "민주화는 단 한 번의 사건이 아니라 오랜 세월에 걸친 점진적 과정이었습니다.", zh: "民主化并非一蹴而就的单一事件，而是历经漫长岁月的渐进过程。" }] },
      { word: '독재', meaning: '独裁', pronunciation: '', examples: [{ ko: "1960년 4·19 혁명은 학생들에 의해 주도되었으며, 이승만 독재 정권을 무너뜨렸습니다.", zh: "1960年的四一九革命由学生们主导，推翻了李承晚独裁政权。" }, { ko: "장기간 이어진 독재 체제는 결국 국민의 저항에 부딪혀 붕괴하였습니다.", zh: "长期延续的独裁体制最终因遭遇国民的抵抗而崩溃。" }] },
      { word: '시위', meaning: '示威游行', pronunciation: '', examples: [{ ko: "전국 각지에서 수백만 명의 시민들에 의해 대규모 시위가 전개되었습니다.", zh: "全国各地数百万市民展开了大规模示威。" }, { ko: "평화로운 시위가 사흘째 이어지며 광장을 가득 메웠습니다.", zh: "和平示威持续到第三天，挤满了整个广场。" }] },
      { word: '탄압', meaning: '镇压', pronunciation: '', examples: [{ ko: "이에 저항하는 수많은 시민과 학생들이 탄압을 받았고, 일부는 목숨을 잃기도 했습니다.", zh: "许多抵抗的市民和学生遭到镇压，部分人甚至献出了生命。" }, { ko: "언론에 대한 정권의 탄압은 오히려 국민의 분노를 키웠습니다.", zh: "政权对新闻媒体的镇压反而激起了国民更大的愤怒。" }] },
      { word: '저항', meaning: '抵抗', pronunciation: '', examples: [{ ko: "2016년 촛불 집회 역시 이러한 민주적 저항의 전통에 의해 영향을 받은 것으로 평가됩니다.", zh: "2016年的烛光集会也被评价为受到这一民主抵抗传统的影响。" }, { ko: "부당한 권력에 맞선 시민들의 저항은 역사의 물줄기를 바꾸어 놓았습니다.", zh: "市民们对抗不义权力的抵抗，改变了历史的走向。" }] },
      { word: '헌법', meaning: '宪法', pronunciation: '', examples: [{ ko: "1970년대에는 박정희 정권에 의해 유신 헌법이 선포되었고, 민주적 권리가 크게 제한되었습니다.", zh: "20世纪70年代，朴正熙政权宣布了维新宪法，民主权利受到严重限制。" }, { ko: "헌법은 국가 권력을 제한하고 국민의 기본권을 보장하는 최고의 규범입니다.", zh: "宪法是限制国家权力、保障国民基本权利的最高规范。" }] },
      { word: '직선제', meaning: '直选制', pronunciation: '', examples: [{ ko: "결국 당시 정권은 국민의 요구를 받아들여 대통령 직선제 개헌을 수용했습니다.", zh: "最终，当时的政权接受了国民的要求，同意了总统直选制的修宪。" }, { ko: "직선제 도입은 국민이 직접 지도자를 선출할 권리를 되찾은 사건이었습니다.", zh: "引入直选制是国民重新夺回直接选举领导人权利的事件。" }] },
      { word: '계엄령', meaning: '戒严令', pronunciation: '', examples: [{ ko: "군부는 시위를 진압하기 위해 전국에 계엄령을 선포하였습니다.", zh: "军部为镇压示威，在全国宣布了戒严令。" }, { ko: "계엄령이 내려지면 시민의 집회와 언론의 자유가 크게 제약됩니다.", zh: "一旦颁布戒严令，市民的集会自由和新闻自由都会受到严重限制。" }] },
      { word: '희생', meaning: '牺牲', pronunciation: '', examples: [{ ko: "민주화 운동에서 희생된 이들의 정신은 현재 한국의 시민 사회에 깊이 뿌리내리고 있습니다.", zh: "在民主化运动中牺牲的人们的精神深深扎根于当今韩国的公民社会中。" }, { ko: "오늘의 자유는 수많은 이들의 희생 위에 세워진 것임을 잊어서는 안 됩니다.", zh: "我们不能忘记，今日的自由是建立在无数人的牺牲之上的。" }] },
      { word: '항쟁', meaning: '抗争', pronunciation: '', examples: [{ ko: "1987년 6월 항쟁은 한국 민주화 역사에서 가장 중요한 전환점으로 평가됩니다.", zh: "1987年的六月抗争被评价为韩国民主化历史上最重要的转折点。" }, { ko: "그 항쟁은 시민과 학생, 노동자가 하나로 결집한 대중적 운동이었습니다.", zh: "那场抗争是市民、学生与劳动者团结一体的群众性运动。" }] },
      { word: '군부', meaning: '军部', pronunciation: '', examples: [{ ko: "1980년 광주에서는 민주화를 요구하는 시민들이 군부에 의해 무력으로 진압되었습니다.", zh: "1980年在光州，要求民主化的市民被军部武力镇压。" }, { ko: "쿠데타로 정권을 장악한 군부는 오랫동안 권력을 놓지 않았습니다.", zh: "通过政变掌握政权的军部长期不肯交出权力。" }] },
      { word: '권력', meaning: '权力', pronunciation: '', examples: [{ ko: "견제받지 않는 권력은 반드시 부패하기 마련이라는 교훈을 남겼습니다.", zh: "它留下了一个教训：不受制衡的权力必然走向腐败。" }, { ko: "민주주의 사회에서 권력은 국민으로부터 나오며 국민에 의해 통제됩니다.", zh: "在民主社会中，权力源自国民，并由国民加以制约。" }] },
      { word: '이행', meaning: '转型/过渡', pronunciation: '', examples: [{ ko: "한국의 민주화 경험은 아시아 다른 나라들에게 민주주의 이행의 모델로 인용되기도 합니다.", zh: "韩国的民主化经验有时也被亚洲其他国家作为民主主义转型的模式加以引用。" }, { ko: "권위주의에서 민주주의로의 이행은 결코 순탄하지만은 않았습니다.", zh: "从威权主义向民主主义的过渡绝非一帆风顺。" }] },
      { word: '유산', meaning: '遗产', pronunciation: '', examples: [{ ko: "그 역사적 유산은 단순한 과거가 아니라 현재에도 살아 숨 쉬는 민주주의의 토대입니다.", zh: "那段历史遗产不仅是简单的过去，更是活在当下的民主主义的基础。" }, { ko: "선조들이 물려준 정신적 유산은 후대가 지켜 나가야 할 소중한 자산입니다.", zh: "先辈留下的精神遗产，是后代应当守护的宝贵财富。" }] },
    ],
    grammarIds: ['g47', 'g54', 'g83', 'g49', 'g21'],
    grammarCardIds: ['card-p13-l05', 'card-p13-l03', 'card-p13-l07', 'card-p13-l01'],
    sentences: [
      {
        id: "s1",
        ko: "1960년 3월 15일, 마산 앞바다에서 한 고등학생의 시신이 떠올랐다.",
        zh: "1960年3月15日，在马山前海，一名高中生的遗体浮出水面。",
        pronunciation: "1960nyeon 3wol 15il, masan apbadaeseo han godeunghaksaengui sisini tteoolratda.",
        words: [{ word: "시신", meaning: "遗体" }, { word: "떠오르다", meaning: "浮上来，浮出" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s2",
        ko: "부정 선거에 항의하던 김주열 군이었다. 그의 죽음은 전국을 뒤흔들었다.",
        zh: "那是抗议不正当选举的金朱烈君。他的死震动了全国。",
        pronunciation: "bujeong seongeoe hanguihadeon gimjuyeol gunieotda. geuui jugeumeun jeongugeul dwiheundeureotda.",
        words: [{ word: "부정 선거", meaning: "不正当选举" }, { word: "뒤흔들다", meaning: "震动，撼动" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s3",
        ko: "이것이 4·19혁명의 도화선이다. 학생들이 거리로 나섰고, 시민들이 합류했다.",
        zh: "这就是4·19革命的导火索。学生们走上街头，市民们加入进来。",
        pronunciation: "igeosi 4·19hyeongmyeongui dohwaseonida. haksaengdeuri georiro naseotgo, simindeuri hamnyuhaetda.",
        words: [{ word: "도화선", meaning: "导火索" }, { word: "합류하다", meaning: "加入，汇合" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s4",
        ko: "4월 19일, 경무대 앞에서 경찰의 발포로 수십 명이 목숨을 잃었다.",
        zh: "4月19日，在景武台前，警方开枪导致数十人丧生。",
        pronunciation: "4wol 19il, gyeongmudae apeseo gyeongcharui balporo susip myeongi moksumeul ilheotda.",
        words: [{ word: "발포", meaning: "开枪" }, { word: "경무대", meaning: "景武台（旧总统府）" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s5",
        ko: "열흘 뒤 이승만은 하야했다. 국민이 독재자를 끌어내린 첫 사건이었다.",
        zh: "十天后李承晚下野了。这是国民第一次把独裁者拉下台。",
        pronunciation: "yeolheul dwi iseungmaneun hayahaetda. gungmini dokjaejareul kkeureonaerin cheot sageonieotda.",
        words: [{ word: "하야하다", meaning: "下野，下台" }, { word: "끌어내리다", meaning: "拉下来" }],
        grammarIds: [],
        difficulty: "easy",
      },
      {
        id: "s6",
        ko: "그러나 그해 5월 16일, 박정희가 이끄는 군부가 쿠데타를 일으켰다. 민주주의의 봄은 고작 한 달 만에 끝났다.",
        zh: "然而那年5月16日，朴正熙领导的军部发动了政变。民主主义的春天仅仅一个月就结束了。",
        pronunciation: "geureona geuhae 5wol 16il, bakjeonghuiga ikkeuneun gunbuga kudetareul ireukyeotda. minjujuuiui bomeun gojak han dal mane kkeunnatda.",
        words: [{ word: "군부", meaning: "军部" }, { word: "쿠데타", meaning: "政变" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s7",
        ko: "이후 18년간의 유신 독재가 이어졌다. 헌법은 유명무실해졌고, 긴급조치로 수많은 사람이 재판 없이 구금됐다.",
        zh: "此后持续了18年的维新独裁。宪法变得有名无实，紧急措施使无数人未经审判就被拘留。",
        pronunciation: "ihu 18nyeonganui yusin dokjaega ieojyeotda. heonbeobeun yumyeongmusilhaejyeotgo, gingeupjochiro sumanheun sarami jaepan eopsi gugeumdwaetda.",
        words: [{ word: "유신", meaning: "维新" }, { word: "유명무실", meaning: "有名无实" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s8",
        ko: "1979년 10월, 박정희가 측근에 의해 피살되면서 모두가 민주화를 기대했다.",
        zh: "1979年10月，朴正熙被亲信枪杀，所有人都期待民主化。",
        pronunciation: "1979nyeon 10wol, bakjeonghuiga cheukgeune uihae pisaldoemyeonseo moduga minjuhwareul gidaehaetda.",
        words: [{ word: "측근", meaning: "亲信" }, { word: "피살되다", meaning: "被杀害" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s9",
        ko: "기대는 다시 한번 무너졌다. 12월 12일, 전두환이 군사 반란을 일으켜 권력을 장악했다.",
        zh: "期待又一次崩塌。12月12日，全斗焕发动军事叛乱掌握了权力。",
        pronunciation: "gidaeneun dasi hanbeon muneojyeotda. 12wol 12il, jeonduhwani gunsa ballaneul ireukyeo gwollyeogeul jangakaetda.",
        words: [{ word: "군사 반란", meaning: "军事叛乱" }, { word: "장악하다", meaning: "掌握，掌控" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s10",
        ko: "1980년 5월 18일, 광주에서는 계엄령에 반대하는 시민들이 하나둘 모여들었다.",
        zh: "1980年5月18日，光州反对戒严令的市民们一个接一个聚集起来。",
        pronunciation: "1980nyeon 5wol 18il, gwangjueseoneun gyeeomryeonge bandaehaneun simindeuri hanadul moyeodeureotda.",
        words: [{ word: "계엄령", meaning: "戒严令" }, { word: "모여들다", meaning: "聚集起来" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s11",
        ko: "전남대학교 정문 앞에서 시작된 시위는 삽시간에 시내 전체로 퍼졌다.",
        zh: "从全南大学正门前开始的示威，瞬间扩散到了全市。",
        pronunciation: "jeonnamdaehakgyo jeongmun apeseo sijakdoen siwineun sapsigane sinae jeonchero peojyeotda.",
        words: [{ word: "삽시간", meaning: "瞬间" }, { word: "시내", meaning: "市内" }],
        grammarIds: [],
        difficulty: "medium",
      },
      {
        id: "s12",
        ko: "5월 21일, 계엄군은 발포를 시작했다. 열흘 동안의 진압으로 공식 집계된 사망자만 165명, 실종자는 74명이었다.",
        zh: "5月21日，戒严军开始了开枪射击。十天镇压中，正式统计的死亡人数便有165人，失踪74人。",
        pronunciation: "5wol 21il, gyeeomguneun balporeul sijakaetda. yeolheul donganui jinabeuro gongsik jipgyedoen samangjaman 165myeong, siljongjaneun 74myeongieotda.",
        words: [{ word: "계엄군", meaning: "戒严军" }, { word: "진압", meaning: "镇压" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s13",
        ko: "당시 광주에 있던 한 의사는 훗날 이렇게 증언했다. \"시체가 너무 많아 병원 복도에 눕혀 둘 수밖에 없었다.\"",
        zh: "当时在光州的一名医生后来这样作证：\"尸体太多，只能放在医院走廊里。\"",
        pronunciation: "dangsi gwangjue itdeon han uisaneun hunnal ireoke jeungeonhaetda. \"sichega neomu manha byeongwon bokdoe nupyeo dul subakke eopseotda.\"",
        words: [{ word: "증언하다", meaning: "作证" }, { word: "복도", meaning: "走廊" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
        id: "s14",
        ko: "이 사건이 바로 5·18민주화운동이다. 수년간 '폭동'으로 불리며 왜곡돼 왔다.",
        zh: "这个事件正是5·18民主化运动。多年来被称作\"暴动\"而遭到歪曲。",
        pronunciation: "i sageoni baro 5·18minjuhwaundongida. sunyeongan 'pokdong'euro bulrimyeo waegokdwae watda.",
        words: [{ word: "폭동", meaning: "暴动" }, { word: "왜곡되다", meaning: "被歪曲" }],
        grammarIds: [],
        difficulty: "hard",
      },
      {
