  coreWords: [
    { word: '가구', meaning: '家庭、户', pronunciation: '', examples: [{ ko: "전체 가구 중 1인 가구가 차지하는 비율이 최근 몇 년 사이에 급증했다.", zh: "在全体家庭中，1人家庭所占的比例在最近几年间急剧上升。" }, { ko: "요즘 도시에는 부부와 자녀로 이루어진 4인 가구보다 1인 가구가 훨씬 많다.", zh: "如今城市里比起由夫妻和子女组成的四口之家，独居家庭要多得多。" }] },
    { word: '부상', meaning: '崛起、抬头', pronunciation: '', examples: [{ ko: "1인 가구의 부상은 한국 사회의 구조적 변화를 보여 주는 대표적인 현상이다.", zh: "独居家庭的崛起是显示韩国社会结构性变化的典型现象。" }, { ko: "온라인 쇼핑의 부상으로 인해 전통적인 오프라인 상점들이 큰 타격을 입었다.", zh: "随着网购的崛起，传统线下商店受到了巨大冲击。" }] },
    { word: '급증하다', meaning: '激增', pronunciation: '', examples: [{ ko: "1인 가구가 차지하는 비율은 최근 몇 년 사이에 급증한 것으로 나타났다.", zh: "1人家庭所占的比例在最近几年间急剧上升。" }, { ko: "명절을 앞두고 기차표를 구하려는 사람들의 문의가 급증했다.", zh: "临近节日，想买火车票的人的咨询急剧增加。" }] },
    { word: '독신', meaning: '单身、独身', pronunciation: '', examples: [{ ko: "요즘은 결혼을 선택하지 않고 독신으로 살아가는 사람들이 늘고 있다.", zh: "如今选择不结婚、以单身生活的人越来越多。" }, { ko: "그는 일에 집중하기 위해 오랫동안 독신 생활을 유지해 왔다.", zh: "他为了专注于工作，长期保持着单身生活。" }] },
    { word: '고령화', meaning: '老龄化', pronunciation: '', examples: [{ ko: "이러한 변화는 결혼에 대한 가치관의 변화와 고령화로 인해 나타난 현상이다.", zh: "这一变化是由婚姻价值观的改变与老龄化所引发的现象。" }, { ko: "농촌 지역은 도시보다 고령화가 훨씬 빠르게 진행되고 있다.", zh: "农村地区的老龄化进程比城市快得多。" }] },
    { word: '소비', meaning: '消费', pronunciation: '', examples: [{ ko: "1인 가구를 겨냥한 새로운 소비 문화도 빠르게 자리를 잡았다.", zh: "针对1人家庭的新消费文化也迅速扎下了根。" }, { ko: "경기가 나빠지면서 사람들의 소비가 눈에 띄게 줄어들었다.", zh: "随着经济变差，人们的消费明显减少了。" }] },
    { word: '외로움', meaning: '孤独感', pronunciation: '', examples: [{ ko: "가까이에서 도와줄 사람이 없다 보면 사소한 일에도 외로움을 느끼기 마련이다.", zh: "若身边没有可以就近帮忙的人，即便是些小事也难免会感到孤独。" }, { ko: "낯선 도시에서 혼자 지내다 보니 문득 외로움이 밀려왔다.", zh: "在陌生的城市独自生活，孤独感突然涌上心头。" }] },
    { word: '고독사', meaning: '孤独死', pronunciation: '', examples: [{ ko: "이웃과의 교류가 끊긴 채 홀로 세상을 떠나는 고독사 문제가 심각한 사회 문제로 떠오르고 있다.", zh: "与邻里断绝往来、独自离世的「孤独死」问题，正浮现为严重的社会问题。" }, { ko: "정부는 고독사를 막기 위해 독거노인을 정기적으로 방문하고 있다.", zh: "政府为防止孤独死，正定期探访独居老人。" }] },
    { word: '안전', meaning: '安全', pronunciation: '', examples: [{ ko: "일부 지방자치단체는 독거노인의 안부를 확인하는 안전 관리 서비스를 운영하고 있다.", zh: "部分地方自治团体正在运营确认独居老人安危的安全管理服务。" }, { ko: "아이들이 마음 놓고 뛰어놀 수 있도록 놀이터의 안전을 점검해야 한다.", zh: "为了让孩子们安心玩耍，应当检查游乐场的安全。" }] },
    { word: '맞춤형', meaning: '定制型、量身定制', pronunciation: '', examples: [{ ko: "기업들은 소비자의 취향에 맞춘 맞춤형 서비스를 잇따라 내놓고 있다.", zh: "各企业正接连推出迎合消费者口味的定制型服务。" }, { ko: "이 학원은 학생 개개인의 수준에 따른 맞춤형 수업을 제공한다.", zh: "这家补习班提供根据每个学生水平量身定制的课程。" }] },
    { word: '정책', meaning: '政策', pronunciation: '', examples: [{ ko: "이러한 지원은 특정 계층에 국한되지 않고 보편적인 정책으로 확대되어야 한다.", zh: "这类扶持不应局限于特定阶层，而应扩展为普惠性的政策。" }, { ko: "새 정부는 청년 실업 문제를 해결하기 위한 정책을 잇따라 발표했다.", zh: "新政府接连公布了旨在解决青年失业问题的政策。" }] },
    { word: '대응하다', meaning: '应对', pronunciation: '', examples: [{ ko: "정부와 지방자치단체는 1인 가구 증가에 대응하기 위한 방안을 마련하기 시작했다.", zh: "政府与地方自治团体开始筹备应对1人家庭增加的方案。" }, { ko: "급변하는 시장 상황에 빠르게 대응하지 못하면 기업은 경쟁에서 뒤처진다.", zh: "若不能对瞬息万变的市场状况快速做出应对，企业就会在竞争中落后。" }] },
    { word: '보편적', meaning: '普遍的', pronunciation: '', examples: [{ ko: "전문가들은 이러한 지원이 보편적인 정책으로 확대되어야 한다고 강조한다.", zh: "专家们强调，这类扶持应扩展为普惠性的政策。" }, { ko: "인간의 존엄성은 문화를 넘어 모두에게 적용되는 보편적 가치이다.", zh: "人的尊严是超越文化、适用于所有人的普世价值。" }] },
    { word: '지원', meaning: '支援、扶持', pronunciation: '', examples: [{ ko: "전문가들은 이러한 지원이 특정 계층에 국한되어서는 안 된다고 강조한다.", zh: "专家们强调，这类扶持不应局限于特定阶层。" }, { ko: "정부는 저소득층 가정에 다양한 형태의 지원을 제공하고 있다.", zh: "政府正向低收入家庭提供多种形式的支援。" }] },
  ],
  grammarIds: ['g21', 'g28', 'g47', 'g49', 'g54'],
  sentences: [
    {
      id: 's1',
      ko: '오늘날 한국 사회에서 혼자 사는 사람은 더 이상 예외적인 존재가 아니다.',
      zh: '如今在韩国社会，独自生活的人已不再是特殊的存在。',
      pronunciation: "oneulnal hanguk sahoeeseo honja saneun sarameun deo isang yeoejeogin jonjaega anida.",
      words: [
        { word: '오늘날', meaning: '如今、当今' },
        { word: '예외적', meaning: '例外的、特殊的' },
        { word: '존재', meaning: '存在' },
      ],
      grammarIds: [],
      difficulty: 'medium',
    },
    {
      id: 's2',
      ko: '통계청 자료에 따르면 전체 가구 중 1인 가구가 차지하는 비율은 최근 몇 년 사이에 급증한 것으로 나타났다.',
      zh: '据统计厅资料显示，在全体家庭中，1人家庭所占的比例在最近几年间急剧上升。',
      pronunciation: "tonggyecheong jaryoe ttareumyeon jeonche gagu jung 1in gaguga chajihaneun biyureun choegeun myeot nyeon saie geupjeunghan geoseuro natanatda.",
      words: [
        { word: '통계청', meaning: '统计厅' },
        { word: '비율', meaning: '比例' },
        { word: '급증하다', meaning: '激增' },
      ],
      grammarIds: ['g21'],
      difficulty: 'hard',
      note: '「-에 따르면」表示依据来源，常用于引用统计或报道。',
    },
    {
      id: 's3',
      ko: '이러한 변화는 결혼에 대한 가치관의 변화와 고령화로 인해 나타난 현상으로 해석된다.',
      zh: '这一变化被解读为由婚姻价值观的改变与老龄化所引发的现象。',
      pronunciation: "ireohan byeonhwaneun gyeolhone daehan gachigwanui byeonhwawa goryeonghwaro inhae natanan hyeonsangeuro haeseokdoenda.",
