      { word: '모임', meaning: '聚会/聚集', pronunciation: '', examples: [{ ko: "취향 중심의 모임이 증가했다고 볼 수 있어요.", zh: "可以认为，以兴趣为中心的聚会增加了。" }, { ko: "주말에 독서 모임에 나가기로 했어요.", zh: "决定周末去参加读书聚会。" }] },
      { word: '취향', meaning: '兴趣/喜好', pronunciation: '', examples: [{ ko: "이 세대는 관계보다 취향을 우선시한다고 볼 수 있어요.", zh: "可以认为，这一代人将兴趣偏好置于关系之上。" }, { ko: "사람마다 음악 취향이 달라요.", zh: "每个人的音乐喜好都不一样。" }] },
      { word: '자기표현', meaning: '自我表达', pronunciation: '', examples: [{ ko: "자기표현이 활발해진 것은 소셜 미디어의 영향이라고 볼 수 있어요.", zh: "可以认为，自我表达变得活跃是社交媒体影响的结果。" }, { ko: "SNS는 젊은 세대의 중요한 자기표현 수단이에요.", zh: "社交网络是年轻一代重要的自我表达手段。" }] },
      { word: '세대', meaning: '世代/一代', pronunciation: '', examples: [{ ko: "디지털 세대의 소통 방식은 새로운 공동체 문화를 만들고 있다고 볼 수 있어요.", zh: "可以认为，数字世代的沟通方式正在创造新的共同体文化。" }, { ko: "세대에 따라 소통 방식이 크게 달라요.", zh: "不同世代的沟通方式差异很大。" }] },
      { word: '디지털', meaning: '数字/Digital', pronunciation: '', examples: [{ ko: "한국 젊은이들의 소셜 문화는 디지털 기술과 함께 빠르게 변화하고 있어요.", zh: "韩国年轻人的社交文化正随着数字技术快速变化。" }, { ko: "디지털 환경에 익숙한 아이들이 늘고 있어요.", zh: "熟悉数字环境的孩子越来越多。" }] },
