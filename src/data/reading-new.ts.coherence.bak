    '理解慢城运动的背景及其对地方再发现的意义',
    '积累韩屋民宿、地方美食等旅行主题高频词汇',
  ],
  coreWords: [
    { word: '슬로시티', meaning: '慢城', pronunciation: '', examples: [{ ko: "이 도시들은 이른바 슬로시티로 지정되어 현대인에게 잠시 멈춰 설 여유를 제공한다.", zh: "这些城市被指定为所谓的慢城，为现代人提供了暂时停下脚步的从容。" }, { ko: "슬로시티에서는 빠른 속도 대신 느린 삶의 가치를 되새기게 된다.", zh: "在慢城里，人们会重新体味慢生活的价值，而非追求速度。" }] },
    { word: '지방', meaning: '地方，外地', pronunciation: '', examples: [{ ko: "최근 몇 년 사이 전주, 담양과 같은 지방의 작은 도시들이 다시 주목받기 시작했다.", zh: "近几年来，全州、潭阳这类地方小城重新受到了关注。" }, { ko: "그는 대학을 졸업한 뒤 서울을 떠나 조용한 지방에서 살기로 했다.", zh: "他大学毕业后决定离开首尔，到安静的地方生活。" }] },
    { word: '한옥', meaning: '韩屋', pronunciation: '', examples: [{ ko: "여행자들이 가장 먼저 경험하고 싶어 하는 것은 한옥에서 하룻밤을 보내는 일이다.", zh: "旅行者最想首先体验的，正是在韩屋里住上一晚。" }, { ko: "전주에는 오래된 한옥이 잘 보존된 마을이 있다.", zh: "全州有一个保存完好的古老韩屋村。" }] },
    { word: '민박', meaning: '民宿', pronunciation: '', examples: [{ ko: "나무와 흙으로 지어진 한옥 민박에 머물다 보면 도시에서는 느낄 수 없던 고요함과 마주하게 된다.", zh: "住在用木头与泥土建成的韩屋民宿里，便会遇见都市中感受不到的宁静。" }, { ko: "우리는 호텔 대신 바닷가 근처의 작은 민박에서 하룻밤을 묵었다.", zh: "我们没住酒店，而是在海边附近的一家小民宿住了一晚。" }] },
    { word: '전통', meaning: '传统', pronunciation: '', examples: [{ ko: "지역의 전통과 풍경을 지키려는 노력은 그 자체로 충분히 의미가 있다.", zh: "守护地区传统与风景的努力，本身就具有充分的意义。" }, { ko: "이 마을은 오랜 전통을 이어 온 도자기 공예로 유명하다.", zh: "这个村庄以传承悠久传统的陶瓷工艺而闻名。" }] },
    { word: '여유', meaning: '从容，余裕', pronunciation: '', examples: [{ ko: "슬로시티는 현대인에게 잠시 멈춰 설 여유를 제공한다.", zh: "慢城为现代人提供了暂时停下脚步的从容。" }, { ko: "마음의 여유가 있어야 주변의 작은 아름다움도 눈에 들어온다.", zh: "只有内心从容，才能注意到周遭细微的美。" }] },
    { word: '풍경', meaning: '风景', pronunciation: '', examples: [{ ko: "지역민들은 자신들이 살아온 골목과 풍경이 지닌 가치를 새롭게 발견하게 되었다.", zh: "当地居民重新发现了自己世代生活的巷子与风景所蕴含的价值。" }, { ko: "기차 창밖으로 펼쳐지는 시골 풍경이 무척 아름다웠다.", zh: "火车窗外铺展开来的乡村风景美极了。" }] },
    { word: '골목', meaning: '巷子，胡同', pronunciation: '', examples: [{ ko: "낯선 지방의 골목을 천천히 걷는 것만으로도 지친 마음이 회복되기 마련이다.", zh: "仅仅是在陌生地方的巷子里慢慢走一走，疲惫的心也自然会得到恢复。" }, { ko: "좁은 골목 안에는 오래된 가게들이 옹기종기 모여 있었다.", zh: "狭窄的巷子里，老店铺密密麻麻地聚在一起。" }] },
    { word: '지역', meaning: '地区，区域', pronunciation: '', examples: [{ ko: "지역의 정취를 온전히 느끼기 위해서는 그 고장의 음식을 맛보아야 한다.", zh: "若要完整感受地区的韵味，就应品尝当地的美食。" }, { ko: "이 지역은 겨울이 길고 눈이 많이 내리는 것으로 유명하다.", zh: "这个地区以冬天漫长、多雪而闻名。" }] },
    { word: '재발견', meaning: '再发现', pronunciation: '', examples: [{ ko: "여행은 익숙한 일상의 가치를 재발견하게 해 주는 소중한 경험이다.", zh: "旅行是让人重新发现熟悉日常之价值的宝贵经历。" }, { ko: "최근 젊은 세대 사이에서 전통문화의 재발견이 활발하게 이루어지고 있다.", zh: "最近在年轻世代之间，对传统文化的再发现正活跃地展开。" }] },
    { word: '일상', meaning: '日常', pronunciation: '', examples: [{ ko: "빠르게 돌아가는 도시의 일상에 지친 사람들이 늘어나고 있다.", zh: "厌倦了快节奏都市日常的人越来越多。" }, { ko: "그는 매일 아침 산책하는 것을 소중한 일상으로 삼고 있다.", zh: "他把每天早上散步当作珍贵的日常。" }] },
    { word: '체험', meaning: '体验', pronunciation: '', examples: [{ ko: "마당을 쓸고 차를 마시는 일상이 여행자에게는 특별한 체험이 된다.", zh: "扫院子、喝茶的日常，对旅行者而言成了特别的体验。" }, { ko: "아이들은 농장에서 직접 채소를 수확하는 체험을 무척 즐거워했다.", zh: "孩子们非常喜欢在农场亲手采收蔬菜的体验。" }] },
    { word: '회복', meaning: '恢复，复原', pronunciation: '', examples: [{ ko: "낯선 골목을 천천히 걷다 보면 지친 마음이 회복되기 마련이다.", zh: "在陌生的巷子里慢慢走着，疲惫的心自然会得到恢复。" }, { ko: "충분한 휴식과 수면은 건강 회복에 무엇보다 중요하다.", zh: "充分的休息与睡眠对健康的恢复比什么都重要。" }] },
    { word: '정취', meaning: '情趣，韵味', pronunciation: '', examples: [{ ko: "지역의 정취를 온전히 느끼기 위해서는 그 고장의 음식을 빼놓을 수 없다.", zh: "若要完整感受地区的韵味，品尝当地美食的过程是绝不能省略的。" }, { ko: "비 내리는 한옥 마을은 도시에서는 느낄 수 없는 고즈넉한 정취가 있다.", zh: "下着雨的韩屋村有着都市里感受不到的静谧韵味。" }] },
