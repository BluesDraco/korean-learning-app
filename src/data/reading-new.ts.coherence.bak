  coreWords: [
    { word: '능력주의', meaning: '能力主义（唯才是举的社会原则）', pronunciation: '', examples: [{ ko: "능력주의란, 개인이 가진 능력과 그가 쏟은 노력에 따라 사회적 지위와 보상이 분배되어야 한다는 원칙을 가리킨다.", zh: "能力主义指的是社会地位与报偿应当依照个人所拥有的能力及其所付出的努力来分配这一原则。" }, { ko: "능력주의는 신분제를 허문 진보적 이념이었으나, 오늘날에는 오히려 불평등을 정당화하는 논리로 비판받기도 한다.", zh: "能力主义曾是瓦解身份制的进步理念，如今却反而作为将不平等正当化的逻辑而遭到批评。" }] },
    { word: '공정성', meaning: '公正性、公平性', pronunciation: '', examples: [{ ko: "능력주의가 표방하는 공정성이 과연 현실에서도 성립하는가 하는 물음이 첨예한 담론으로 떠올랐다.", zh: "能力主义所标榜的公正性在现实中是否真能成立——这一问题已成为尖锐的话语。" }, { ko: "절차의 공정성만을 강조하다 보면 출발선의 불평등이라는 더 근본적인 문제를 놓치기 쉽다.", zh: "若一味强调程序的公正性，便容易忽略起跑线不平等这一更为根本的问题。" }] },
    { word: '담론', meaning: '话语、论述、思潮', pronunciation: '', examples: [{ ko: "공정성에 대한 물음은 최근 한국 사회에서 가장 첨예한 담론의 하나로 떠올랐다.", zh: "关于公正性的追问，近来已成为韩国社会最尖锐的话语之一。" }, { ko: "공정 담론은 청년 세대의 좌절과 맞물리면서 정치권 전반으로 빠르게 확산되었다.", zh: "公正话语与青年世代的挫折相互交织，迅速扩散至整个政界。" }] },
    { word: '세습', meaning: '世袭', pronunciation: '', examples: [{ ko: "능력주의를 옹호하는 이들은 시험이야말로 연줄과 세습을 차단하는 가장 투명한 장치라고 주장한다.", zh: "拥护能力主义者主张，考试才正是阻断人脉与世袭的最透明的机制。" }, { ko: "재산뿐 아니라 교육 기회까지 대물림되는 부의 세습은 계층 이동을 가로막는다.", zh: "不仅财产、连教育机会都被代代相传的财富世袭，阻碍着阶层的流动。" }] },
    { word: '계층', meaning: '阶层', pronunciation: '', examples: [{ ko: "교육이 신분 상승의 사다리로 기능하던 시대와 달리, 오늘날 계층은 좀처럼 넘나들기 어려워졌다.", zh: "与教育曾作为身份上升阶梯的时代不同，如今阶层已变得难以逾越。" }, { ko: "노동 시장의 이중 구조는 계층 간 격차를 고착시키는 핵심 요인으로 지목된다.", zh: "劳动市场的双重结构被指为固化阶层间差距的核心因素。" }] },
    { word: '이동성', meaning: '（社会）流动性', pronunciation: '', examples: [{ ko: "계층 이동성이 낮은 사회일수록 개인의 노력이 성취로 이어질 가능성은 줄어든다.", zh: "阶层流动性越低的社会，个人的努力转化为成就的可能性就越小。" }, { ko: "사회적 이동성이 막히면 능력주의가 내세우던 희망의 서사는 설득력을 잃는다.", zh: "社会流动性一旦被堵塞，能力主义所标榜的希望叙事便丧失了说服力。" }] },
    { word: '전제', meaning: '前提', pronunciation: '', examples: [{ ko: "능력주의의 정당성은 누구에게나 기회가 평등하게 주어진다는 전제 위에서만 성립한다.", zh: "能力主义的正当性，只有在人人机会平等这一前提之上才能成立。" }, { ko: "출발선이 이미 기울어져 있다면 공정한 경쟁이라는 전제 자체가 무너진 셈이다.", zh: "倘若起跑线早已倾斜，那么公平竞争这一前提本身便已崩塌。" }] },
    { word: '보상', meaning: '报偿、回报', pronunciation: '', examples: [{ ko: "노력에 대한 정당한 보상마저 부정한다면 사회는 활력을 잃고 말 것이다.", zh: "倘若连对努力的正当报偿都予以否定，社会终将丧失活力。" }, { ko: "성과에 따른 보상 체계는 동기를 부여하지만, 지나치면 승자독식을 정당화하는 논리로 변질된다.", zh: "依成果给予报偿的体系能激励动机，但若过度，便会蜕变为将赢家通吃正当化的逻辑。" }] },
    { word: '정당화', meaning: '正当化、合理化', pronunciation: '', examples: [{ ko: "더욱 심각한 문제는 능력주의가 불평등을 도덕적으로 정당화한다는 점에 있다.", zh: "更为严重的问题在于，能力主义还将不平等在道德上加以正当化。" }, { ko: "결과의 격차를 오로지 개인의 능력 탓으로 돌리는 논리는 구조적 모순을 정당화하는 데 쓰인다.", zh: "把结果差距一味归咎于个人能力的逻辑，被用来将结构性矛盾正当化。" }] },
    { word: '불평등', meaning: '不平等', pronunciation: '', examples: [{ ko: "능력주의는 단지 불평등을 낳는 데 그치지 않고, 그 불평등을 도덕적으로 정당화한다.", zh: "能力主义不仅仅止步于制造不平等，还将那种不平等在道德上加以正当化。" }, { ko: "기회의 불평등을 방치한 채 결과만을 문제 삼는 것은 본말이 전도된 접근이다.", zh: "在放任机会不平等的情况下只拿结果说事，是一种本末倒置的做法。" }] },
    { word: '기회', meaning: '机会', pronunciation: '', examples: [{ ko: "기회의 평등을 진정으로 실현하려면 사회가 유아기에서부터 두터운 안전망을 깔아야 한다.", zh: "若要真正实现机会的平等，社会就须从幼年期开始便铺设一张厚实的安全网。" }, { ko: "모두에게 동등한 기회가 보장되지 않는다면 경쟁의 결과를 온전히 개인의 몫으로 볼 수 없다.", zh: "倘若无法保障人人机会均等，便不能将竞争的结果完全视为个人一己之功。" }] },
    { word: '노력', meaning: '努力', pronunciation: '', examples: [{ ko: "시험 성적이 온전히 노력의 산물이라는 믿음은 그 성적을 떠받치는 사회적 조건을 지워 버리는 착시일 수 있다.", zh: "认为考试成绩全然是努力之产物的信念，或许是一种把支撑该成绩的社会条件抹去的错觉。" }, { ko: "노력이 결실을 맺으려면 그 노력을 뒷받침할 최소한의 여건이 먼저 갖추어져야 한다.", zh: "努力要想结出果实，须先具备支撑这份努力的最起码的条件。" }] },
    { word: '역량', meaning: '能力、实力（可培养的综合素质）', pronunciation: '', examples: [{ ko: "개인의 역량이 자라나는 유아기와 교육의 초입에서부터 사회가 촘촘한 안전망을 깔아야 한다.", zh: "社会须从个人能力生长的幼年期与教育起点开始，便密密地铺设安全网。" }, { ko: "역량이란 타고나는 것이 아니라 오랜 시간 축적된 환경 속에서 길러지는 것이다.", zh: "所谓能力并非与生俱来，而是在长期积累的环境中被培养起来的。" }] },
    { word: '연대', meaning: '连带、团结', pronunciation: '', examples: [{ ko: "승자에게는 오만이, 패자에게는 굴욕이 남으면서 공동체의 연대는 서서히 무너지기에 이른다.", zh: "胜者留下傲慢，败者留下屈辱，共同体的连带便渐渐走向崩解。" }, { ko: "각자도생의 논리가 팽배할수록 사회를 지탱하던 연대의 감각은 옅어져 간다.", zh: "各自求生的逻辑越是泛滥，曾维系社会的连带感便越发淡薄。" }] },
  ],
  grammarIds: ['g21', 'g47', 'g49', 'g54', 'g83'],
  sentences: [
    {
      id: "s1",
      ko: "2024년 11월 14일 밤 11시, 서울 강남의 한 스터디카페는 빈자리가 하나도 없었다.",
      zh: "2024年11月14日晚11点，首尔江南的一家自习咖啡馆里一个空位都没有。",
      pronunciation: "2024nyeon 11wol 14il bam 11si, seoul gangnamui han seuteodikapeneun binjariga hanado eopseotda.",
      words: [{"word":"스터디카페","meaning":"自习咖啡馆"},{"word":"빈자리","meaning":"空位"}],
      grammarIds: [],
