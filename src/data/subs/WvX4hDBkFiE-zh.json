注意到我有多糟糕，"},{"s":582.132,"e":583.066,"t":"我有多糟糕。"},{"s":583.876,"e":585.016,"t":"损失"},{"s":585.016,"e":587.036,"t":"因为害怕被别人察觉"},{"s":587.259,"e":588.489,"t":"所以胆怯"},{"s":589.639,"e":591.659,"t":"我是那样的讨厌我自己"},{"s":592.355,"e":593.965,"t":"既然不满意"},{"s":595.041,"e":597.031,"t":"为了这个让人心疼的人，"},{"s":597.771,"e":600.541,"t":"我一边唠叨，一边责打，又一边费尽心思。"},{"s":601.076,"e":604.366,"t":"因为那种不成熟、毫无顾忌的执着，"},{"s":604.404,"e":608.064,"t":"好不容易才学会去爱自己。"},{"s":609.601,"e":612.021,"t":"而且幸运的是，"},{"s":613.47,"e":617.85,"t":"当我对自己产生怜悯之后，"},{"s":618.901,"e":621.151,"t":"我才开始真正地观察周围。"},{"s":623.051,"e":624.761,"t":"因为我甚至都顾不上自己，"},{"s":626.567,"e":628.937,"t":"直到产生了自我同情心，"},{"s":629.427,"e":631.807,"t":"才略有能力健康地调整，"},{"s":632.134,"e":633.664,"t":"然后去关注别人。"},{"s":634.528,"e":636.458,"t":"我发现别人也没什么不同。"},{"s":636.458,"e":638.488,"t":"无论看起来多么优秀的人，"},{"s":638.488,"e":639.908,"t":"多么从容的人，"},{"s":639.908,"e":641.568,"t":"其实都一样。"},{"s":643.061,"e":644.091,"t":"但是为什么，"},{"s":644.533,"e":646.133,"t":"又不是别人"},{"s":647.693,"e":649.563,"t":"爱自己"},{"s":650.131,"e":651.721,"t":"只是爱我自己"},{"s":651.721,"e":653.711,"t":"为什么会这么难呢？"},{"s":655.581,"e":656.481,"t":"自我贬低，"},{"s":657.435,"e":658.355,"t":"自我破坏，"},{"s":659.396,"e":661.126,"t":"陷入情绪的循环，"},{"s":661.596,"e":663.696,"t":"像被困在滚筒洗衣机里一样，"},{"s":665.727,"e":666.817,"t":"连最理所当然的"},{"s":666.871,"e":669.771,"t":"自我怜悯，也变得令人羞愧。"},{"s":671.37,"e":672.95,"t":"这难道不是非常冤吗？"},{"s":673.612,"e":675.682,"t":"现在想想，"},{"s":676.138,"e":678.128,"t":"这些话都不能随便和别人说，"},{"s":678.642,"e":680.152,"t":"因为不能说啊，"},{"s":680.713,"e":682.153,"t":"只能装作正常。"},{"s":682.915,"e":683.954,"t":"而那种自我怜惜之心，"},{"s":683.954,"e":687.594,"t":"那种的爱惜的感情，慢慢地改变了我，"},{"s":688.17,"e":689.48,"t":"改变了周围的人，"},{"s":690.137,"e":693.747,"t":"改变了我的小世界， 我以前完全没意识到它的力量。"},{"s":694.137,"e":695.317,"t":"我以前不知道，"},{"s":696.38,"e":698.66,"t":"现在好像终于意识到了那种力量。"},{"s":700.107,"e":702.197,"t":"当然，别看我现在这么说，"},{"s":703.19,"e":704.29,"t":"但我依然，"},{"s":707.036,"e":709.776,"t":"在电脑硬盘里堆着数百首、几十首歌曲，"},{"s":710.552,"e":713.402,"t":"因为不满意，依然没发布。"},{"s":714.336,"e":715.136,"t":"明明"},{"s":715.136,"e":716.696,"t":"想被爱，"},{"s":718.06,"e":719.56,"t":"连联系别人都做不好，"},{"s":719.56,"e":720.54,"t":"真是抱歉。"},{"s":723.679,"e":728.107,"t":"我想穿漂亮的衣服，拍照发一天美好的生活，"},{"s":728.107,"e":730.591,"t":"但总想着“会不会不好看？会不会奇怪？”"},{"s":731.171,"e":732.731,"t":"就这样反复纠结。"},{"s":733.371,"e":734.151,"t":"我仍然，"},{"s":734.151,"e":735.381,"t":"还是这样，"},{"s":736.581,"e":737.871,"t":"但正因为"},{"s":738.096,"e":740.186,"t":"一直和自己斗争，"},{"s":741.117,"e":742.367,"t":"一直斗争，"},{"s":743.199,"e":745.119,"t":"才想要赢一次。"},{"s":745.592,"e":749.932,"t":"所以今天鼓起勇气， 站在这里。"},{"s":760.473,"e":762.368,"t":"是的，只是为了讲这样"},{"s":762.485,"e":764.382,"t":"一点不值一提的话，"},{"s":764.382,"e":765.502,"t":"我鼓起了勇气。"},{"s":768.138,"e":769.818,"t":"以后，让我们允许"},{"s":770.392,"e":772.532,"t":"那些自己想要遮盖的东西，"},{"s":775.126,"e":776.626,"t":"一直存在吧。"},{"s":776.839,"e":779.139,"t":"遮盖我的东西，不是过去的不足，"},{"s":779.389,"e":780.949,"t":"也不是自卑，"},{"s":781.993,"e":783.753,"t":"而是我们想成为的我们，"},{"s":784.053,"e":785.563,"t":"希望成为我想成为的自己，"},{"s":786.313,"e":788.193,"t":"希望过上我想过的生活，"},{"s":788.193,"e":790.453,"t":"希望能用那些东西去遮盖，"},{"s":791.086,"e":792.356,"t":"从这个角度来看，"},{"s":792.535,"e":793.685,"t":"最后，"},{"s":794.483,"e":795.633,"t":"接下来，"},{"s":796.076,"e":799.726,"t":"我想谈谈我想要遮盖的未来。"},{"s":800.136,"e":800.956,"t":"我"},{"s":801.652,"e":803.652,"t":"想长久地做音乐。"},{"s":805.465,"e":806.235,"t":"真的。"},{"s":806.798,"e":808.738,"t":"这个国家发展节奏太快了，"},{"s":808.738,"e":809.838,"t":"实在太快了，"},{"s":810.397,"e":812.277,"t":"外卖一叫就到，"},{"s":814.705,"e":816.535,"t":"快到什么程度呢？"},{"s":817.088,"e":817.878,"t":"我"},{"s":818.194,"e":820.144,"t":"小时候熟悉的城市景象，"},{"s":820.144,"e":821.504,"t":"几乎已经不在了。"},{"s":823.651,"e":825.741,"t":"全是新建筑，"},{"s":825.741,"e":826.991,"t":"各种新技术"},{"s":826.991,"e":828.831,"t":"混凝土盖满一切，"},{"s":829.081,"e":831.061,"t":"被遮挡。"},{"s":831.446,"e":834.536,"t":"我所在的文化产业也差不多。"},{"s":835.624,"e":836.511,"t":"流行文化，"},{"s":836.511,"e":838.747,"t":"我理解流行的价值，"},{"s":838.747,"e":840.068,"t":"非常有价值，对吧。"},{"s":840.673,"e":841.623,"t":"非常重要"},{"s":841.623,"e":842.413,"t":"非常值得尊重。"},{"s":842.413,"e":843.323,"t":"但是，"},{"s":843.323,"e":844.543,"t":"我希望这个市场，"},{"s":845.231,"e":847.021,"t":"能有更多古"},{"s":847.049,"e":849.629,"t":"老而精彩的作品和人。"},{"s":849.861,"e":850.701,"t":"那是我的梦想，"},{"s":850.701,"e":852.201,"t":"我也想成为那样的人"},{"s":852.201,"e":853.201,"t":"所以，"},{"s":853.201,"e":854.851,"t":"请多来我的演出，"},{"s":866.054,"e":867.847,"t":"也请多听我的歌。"},{"s":868.668,"e":870.478,"t":"我会努力的，"},{"s":870.818,"e":872.698,"t":"努力活着，"},{"s":872.698,"e":873.698,"t":"努力拼搏。"},{"s":873.698,"e":876.318,"t":"希望能活得更长久，更持久，请稍微帮我一下。"},{"s":877.312,"e":879.522,"t":"就以这样一种相互的心意，"},{"s":881.294,"e":883.454,"t":"结束今天这场像自言自语一样的讲述。"},{"s":883.454,"e":884.704,"t":"谢谢大家。"}]